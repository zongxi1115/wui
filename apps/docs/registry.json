{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "wui",
  "homepage": "http://localhost:3000",
  "items": [
    {
      "name": "utils",
      "type": "registry:lib",
      "title": "cn utility",
      "description": "Tailwind class merge helper used by every component.",
      "dependencies": [
        "clsx",
        "tailwind-merge"
      ],
      "files": [
        {
          "path": "registry/lib/utils.ts",
          "type": "registry:lib"
        }
      ]
    },
    {
      "name": "button",
      "type": "registry:ui",
      "title": "Button",
      "description": "Displays a button or a component that looks like a button.",
      "dependencies": [
        "radix-ui",
        "class-variance-authority",
        "motion"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "registry/ui/button.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "dialog",
      "type": "registry:ui",
      "title": "Dialog",
      "description": "A window overlaid on the primary window, built on Radix UI.",
      "dependencies": [
        "radix-ui",
        "lucide-react",
        "motion"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "registry/ui/dialog.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "watermark",
      "type": "registry:ui",
      "title": "Watermark",
      "description": "Adds a repeated text watermark over a section of content.",
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "registry/ui/watermark.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "confirm-dialog",
      "type": "registry:component",
      "title": "Confirm Dialog",
      "description": "A ready-made confirmation dialog composed from Dialog and Button.",
      "registryDependencies": [
        "dialog",
        "button"
      ],
      "files": [
        {
          "path": "registry/components/confirm-dialog.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "motion",
      "type": "registry:ui",
      "title": "Motion",
      "description": "Optional animation primitive and presets built on motion.",
      "dependencies": [
        "motion",
        "radix-ui"
      ],
      "files": [
        {
          "path": "registry/ui/motion.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "shiny-button",
      "type": "registry:ui",
      "title": "Shiny Button",
      "description": "A filled button with a light sweep that glides across it.",
      "categories": [
        "fancy"
      ],
      "dependencies": [
        "motion"
      ],
      "registryDependencies": [
        "utils"
      ],
      "files": [
        {
          "path": "registry/ui/shiny-button.tsx",
          "type": "registry:ui"
        }
      ]
    }
  ]
}
