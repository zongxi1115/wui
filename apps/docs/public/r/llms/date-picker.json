{
  "name": "date-picker",
  "type": "registry:ui",
  "title": "日期选择器 Date Picker",
  "description": "在紧凑弹层中选择、格式化和清除日期。",
  "import": "import { DatePicker } from \"@/components/ui/date-picker\"",
  "exports": [
    "DatePicker"
  ],
  "typeExports": [
    "DatePickerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/date-picker",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/date-picker.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react"
    ],
    "registryDependencies": [
      "utils",
      "calendar"
    ]
  },
  "props": [
    {
      "name": "value",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "当前选中的日期。"
    },
    {
      "name": "defaultValue",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "非受控模式下初始选中的日期。"
    },
    {
      "name": "onValueChange",
      "type": "((date: Date) => void)",
      "required": false,
      "control": "text",
      "description": "选择或清除日期后触发。"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "选择日期",
      "description": "没有选中日期时显示的占位文本。"
    },
    {
      "name": "locale",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "zh-CN",
      "description": "格式化日期时使用的地区设置。"
    },
    {
      "name": "formatOptions",
      "type": "DateTimeFormatOptions",
      "required": false,
      "control": "text",
      "description": "传递给 Intl.DateTimeFormat 的日期格式化选项。"
    },
    {
      "name": "clearable",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否允许清除当前日期。"
    },
    {
      "name": "min",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "允许选择的最早日期。"
    },
    {
      "name": "max",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "允许选择的最晚日期。"
    },
    {
      "name": "disabledDate",
      "type": "((date: Date) => boolean)",
      "required": false,
      "control": "text",
      "description": "用于判断日期是否禁用的匹配函数。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "events": "`onValueChange(date | undefined)` 在选择或清空日期后触发。选中日期后弹层会自动关闭；点击清除按钮不会重新打开弹层。\n受控用法下，回调需要同步更新 `value`，否则触发器仍会显示旧日期。",
  "examples": [
    {
      "name": "date-picker-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/date-picker.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/date-picker",
  "sourceUrl": "https://ui.wzx.wang/r/date-picker.json"
}
