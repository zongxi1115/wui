{
  "name": "text-shimmer",
  "type": "registry:ui",
  "title": "文本扫光 Text Shimmer",
  "description": "在文字表面循环扫过的主题感知高光。",
  "categories": [
    "motion",
    "text-effect"
  ],
  "import": "import { TextShimmer } from \"@/components/ui/text-shimmer\"",
  "exports": [
    "TextShimmer"
  ],
  "typeExports": [
    "TextShimmerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/text-shimmer",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/text-shimmer.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "string",
      "required": true,
      "control": "text",
      "description": "承载扫光效果的文字。"
    },
    {
      "name": "as",
      "type": "ElementType<any, keyof IntrinsicElements>",
      "required": false,
      "control": "text",
      "defaultValue": "span",
      "description": "组件实际渲染的 HTML 元素。"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "2",
      "description": "高光完整扫过一次所需的时间，单位为秒。"
    },
    {
      "name": "spread",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "2",
      "description": "高光渐变相对文字宽度的范围。"
    }
  ],
  "events": "组件没有自有事件，并透传底层元素事件。动画会持续循环；用户开启“减少动态效果”时停留在静态渐变状态。",
  "examples": [
    {
      "name": "text-shimmer-demo",
      "title": "基础用法"
    },
    {
      "name": "text-shimmer-wave-demo"
    }
  ],
  "files": [
    "registry/ui/text-shimmer.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/text-shimmer",
  "sourceUrl": "https://ui.wzx.wang/r/text-shimmer.json"
}
