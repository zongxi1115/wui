        }
      ]
    }
  ],
  "types": [
    {
      "name": "ChartDatum",
      "definition": "export type ChartDatum = Record<string, string | number | null | undefined>"
    },
    {
      "name": "ComposedSeries",
      "definition": "export interface ComposedSeries extends ChartSeries {\r\n  /** 序列使用柱形或折线。 */\r\n  type: \"bar\" | \"line\"\r\n  /** 序列使用左侧或右侧纵轴。 @default \"left\" */\r\n  axis?: \"left\" | \"right\"\r\n}"
    },
    {
      "name": "ChartSeries",
      "definition": "export interface ChartSeries {\r\n  /** 数据字段名。 */\r\n  key: string\r\n  /** 图例和提示框中显示的名称。 */\r\n  label?: string\r\n  /** 覆盖当前序列的颜色。 */\r\n  color?: string\r\n  /** 折线序列的 SVG 虚线模式。 */\r\n  strokeDasharray?: string\r\n}"
    }
  ],
  "usage": "`ComposedChart` 只在两个不同单位确实共享横轴、且关系值得并置时使用双轴。左右轴都必须在副标题中明确单位，避免读者把不同尺度的形状误认为直接相关。\n每个序列通过 `type` 选择柱形或折线，通过 `axis` 选择纵轴。",
  "examples": [
    {
      "name": "composed-chart-demo"
    }
  ],
