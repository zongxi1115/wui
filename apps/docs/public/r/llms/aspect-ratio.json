{
  "name": "aspect-ratio",
  "type": "registry:ui",
  "title": "宽高比 Aspect Ratio",
  "description": "在响应式弹性布局中为图片、视频播放器或媒体卡片锁定固定的宽高比例，防止页面布局抖动（CLS）。",
  "import": "import { AspectRatio } from \"@/components/ui/aspect-ratio\"",
  "exports": [
    "AspectRatio"
  ],
  "typeExports": [
    "AspectRatioProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/aspect-ratio",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/aspect-ratio.json",
    "npmDependencies": [
      "radix-ui"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "ratio",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "1",
      "description": "宽度与高度的比例，例如 16 / 9。@default 1"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "examples": [
    {
      "name": "aspect-ratio-demo",
      "title": "基础用法"
    },
    {
      "name": "aspect-ratio-card",
      "title": "视频媒体卡片与播放覆盖层"
    },
    {
      "name": "aspect-ratio-advanced",
      "title": "多比例媒体画廊 (4:5, 1:1, 3:2)"
    }
  ],
  "files": [
    "registry/ui/aspect-ratio.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/aspect-ratio",
  "sourceUrl": "https://ui.wzx.wang/r/aspect-ratio.json"
}
