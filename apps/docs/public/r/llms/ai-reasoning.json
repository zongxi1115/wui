{
  "name": "ai-reasoning",
  "type": "registry:ui",
  "title": "AI 推理过程 AI Reasoning",
  "description": "用可折叠的思考链展示模型推理摘要与执行进度。",
  "categories": [
    "ai"
  ],
  "import": "import { AiReasoning, AiReasoningContent, AiReasoningStep, AiReasoningTrigger, aiReasoningStepVariants } from \"@/components/ui/ai-reasoning\"",
  "exports": [
    "AiReasoning",
    "AiReasoningContent",
    "AiReasoningStep",
    "AiReasoningTrigger",
    "aiReasoningStepVariants"
  ],
  "typeExports": [
    "AiReasoningProps",
    "AiReasoningStepProps",
    "AiReasoningTriggerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/ai-reasoning",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/ai-reasoning.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority",
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils",
      "ai-stream"
    ]
  },
  "props": [
    {
      "name": "isStreaming",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否仍在接收推理过程。"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "control": "number",
      "description": "已完成的推理耗时，单位为秒。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "组件透传 Radix Collapsible 的 `open` 和 `onOpenChange`。非受控模式下，`isStreaming` 变为 `true` 时自动展开，\n从 `true` 变为 `false` 时自动收起；受控模式由调用方决定展开策略。内容区域在流式阶段使用 `aria-live` 和 `aria-busy` 通知辅助技术。",
  "examples": [
    {
      "name": "ai-reasoning-demo",
      "title": "基础用法"
    },
    {
      "name": "ai-reasoning-advanced"
    }
  ],
  "files": [
    "registry/ui/ai-reasoning.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/ai-reasoning",
  "sourceUrl": "https://ui.wzx.wang/r/ai-reasoning.json"
}
