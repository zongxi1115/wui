{
  "name": "bubble",
  "type": "registry:ui",
  "title": "气泡 Bubble",
  "description": "可组合头像、署名、正文、时间与操作区的通用消息气泡。",
  "import": "import { Bubble, BubbleActions, BubbleAvatar, BubbleBody, BubbleContent, BubbleFooter, BubbleHeader, bubbleContentVariants, bubbleVariants } from \"@/components/ui/bubble\"",
  "exports": [
    "Bubble",
    "BubbleActions",
    "BubbleAvatar",
    "BubbleBody",
    "BubbleContent",
    "BubbleFooter",
    "BubbleHeader",
    "bubbleContentVariants",
    "bubbleVariants"
  ],
  "typeExports": [
    "BubbleContentProps",
    "BubbleProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/bubble",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/bubble.json",
    "npmDependencies": [
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "side",
      "type": "\"start\" | \"end\"",
      "required": false,
      "control": "select",
      "options": [
        "start",
        "end"
      ],
      "defaultValue": "start",
      "description": "消息气泡的水平对齐方向。"
    }
  ],
  "events": "所有部件都会透传对应原生元素事件。`side` 只控制视觉方向，不会判断消息发送者；消息菜单、复制、重试和已读回执等行为，\n应由业务层绑定到 `BubbleActions` 中的按钮。",
  "examples": [
    {
      "name": "bubble-demo",
      "title": "基础用法"
    },
    {
      "name": "bubble-variants",
      "title": "表面样式"
    }
  ],
  "files": [
    "registry/ui/bubble.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/bubble",
  "sourceUrl": "https://ui.wzx.wang/r/bubble.json"
}
