{
  "name": "radio-group",
  "type": "registry:ui",
  "title": "单选框 Radio Group",
  "description": "用于互斥选项的轻量单选控件组。",
  "import": "import { RadioGroup, RadioGroupItem, radioGroupItemVariants } from \"@/components/ui/radio-group\"",
  "exports": [
    "RadioGroup",
    "RadioGroupItem",
    "radioGroupItemVariants"
  ],
  "typeExports": [
    "RadioGroupItemProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/radio-group",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/radio-group.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "`onValueChange(value)` 在选择变化后触发，参数是当前选项的 `value`。`RadioGroupItem` 必须设置唯一的 `value`；\n原生焦点、禁用与表单属性会继续透传。受控模式下，回调需要同步更新外部 `value`。",
  "examples": [
    {
      "name": "radio-group-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/radio-group.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/radio-group",
  "sourceUrl": "https://ui.wzx.wang/r/radio-group.json"
}
