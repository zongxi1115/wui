{
  "name": "radio-group",
  "type": "registry:ui",
  "title": "单选框 Radio Group",
  "description": "用于互斥选项的轻量单选控件组。",
  "import": "import { RadioGroup, RadioGroupItem, radioGroupItemVariants } from \"@/components/ui/radio-group\"",
  "exports": [
    "RadioGroup",
    "RadioGroupItem",
    "radioGroupItemVariants"
  ],
  "typeExports": [
    "RadioGroupItemProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/radio-group",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/radio-group.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean"
    }
  ],
  "usage": "`RadioGroup` 用于从两个或更多互斥选项中选择一项。环形边框与全局主色实心圆点保持清晰的选中反馈，同时保留方向键切换、焦点管理与表单语义。",
  "extended": "通过 `orientation` 控制键盘导航方向，通过 `disabled` 禁用整组或单项。`RadioGroupItem` 支持 `size=\"sm | default | lg\"`，标签应使用原生 `label` 包裹或通过 `htmlFor` 关联。",
  "events": "`onValueChange(value)` 在选择变化后触发。`RadioGroupItem` 接收必需的 `value`，原生焦点、禁用与表单属性会继续透传。",
  "examples": [
    {
      "name": "radio-group-demo",
      "title": "基础示例"
    }
  ],
  "files": [
    "registry/ui/radio-group.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/radio-group",
  "sourceUrl": "https://ui.wzx.wang/r/radio-group.json"
}
