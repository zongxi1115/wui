{
  "name": "timeline",
  "type": "registry:ui",
  "title": "时间轴 Timeline",
  "description": "按照明确的时间先后顺序呈现事件流转、操作日志、发布进度与业务里程碑。",
  "import": "import { Timeline, TimelineCard, TimelineContent, TimelineDescription, TimelineDot, TimelineHeader, TimelineItem, TimelineMeta, TimelineSeparator, TimelineTime, TimelineTitle, timelineDotVariants } from \"@/components/ui/timeline\"",
  "exports": [
    "Timeline",
    "TimelineCard",
    "TimelineContent",
    "TimelineDescription",
    "TimelineDot",
    "TimelineHeader",
    "TimelineItem",
    "TimelineMeta",
    "TimelineSeparator",
    "TimelineTime",
    "TimelineTitle",
    "timelineDotVariants"
  ],
  "typeExports": [
    "TimelineDotProps",
    "TimelineItemProps",
    "TimelineProps",
    "TimelineSeparatorProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/timeline",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/timeline.json",
    "npmDependencies": [
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "orientation",
      "type": "\"horizontal\" | \"vertical\"",
      "required": false,
      "options": [
        "horizontal",
        "vertical"
      ],
      "defaultValue": "vertical",
      "description": "时间线的排列方向。"
    },
    {
      "name": "align",
      "type": "\"start\" | \"alternate\"",
      "required": false,
      "options": [
        "start",
        "alternate"
      ],
      "defaultValue": "start",
      "description": "内容相对时间线的对齐方式。交错对齐仅在纵向布局中生效。"
    },
    {
      "name": "density",
      "type": "\"compact\" | \"default\"",
      "required": false,
      "options": [
        "compact",
        "default"
      ],
      "defaultValue": "default",
      "description": "事件之间的间距尺寸。"
    },
    {
      "name": "connector",
      "type": "\"solid\" | \"dashed\"",
      "required": false,
      "options": [
        "solid",
        "dashed"
      ],
      "defaultValue": "solid",
      "description": "连接线的视觉样式。"
    },
    {
      "name": "animated",
      "type": "boolean",
      "required": false,
      "defaultValue": "true",
      "description": "条目滚动进入视口时，是否依次淡入、弹出节点并绘制连接线。"
    }
  ],
  "api": [
    {
      "name": "Timeline",
      "props": [
        {
          "name": "orientation",
          "type": "\"horizontal\" | \"vertical\"",
          "required": false,
          "options": [
            "horizontal",
            "vertical"
          ],
          "defaultValue": "vertical",
          "description": "时间线的排列方向。"
        },
        {
          "name": "align",
          "type": "\"start\" | \"alternate\"",
          "required": false,
          "options": [
            "start",
            "alternate"
          ],
          "defaultValue": "start",
          "description": "内容相对时间线的对齐方式。交错对齐仅在纵向布局中生效。"
        },
        {
          "name": "density",
          "type": "\"compact\" | \"default\"",
          "required": false,
          "options": [
            "compact",
            "default"
          ],
          "defaultValue": "default",
          "description": "事件之间的间距尺寸。"
        },
        {
          "name": "connector",
          "type": "\"solid\" | \"dashed\"",
          "required": false,
          "options": [
            "solid",
            "dashed"
          ],
          "defaultValue": "solid",
          "description": "连接线的视觉样式。"
        },
        {
          "name": "animated",
          "type": "boolean",
          "required": false,
          "defaultValue": "true",
          "description": "条目滚动进入视口时，是否依次淡入、弹出节点并绘制连接线。"
        }
      ]
    },
    {
      "name": "TimelineCard",
      "props": []
    },
    {
      "name": "TimelineContent",
      "props": []
    },
    {
      "name": "TimelineDescription",
      "props": []
    },
    {
      "name": "TimelineDot",
      "props": [
        {
          "name": "variant",
          "type": "\"default\" | \"destructive\" | \"success\" | \"warning\" | \"primary\"",
          "required": false,
          "options": [
            "default",
            "destructive",
            "success",
            "warning",
            "primary"
          ],
          "defaultValue": "default",
          "description": "Semantic marker color."
        },
        {
          "name": "size",
          "type": "\"icon\" | \"dot\"",
          "required": false,
          "options": [
            "icon",
            "dot"
          ],
          "defaultValue": "dot",
          "description": "Marker shape. Icon markers accept an icon as children."
        },
        {
          "name": "pulse",
          "type": "boolean",
          "required": false,
          "defaultValue": "false",
          "description": "Draw attention to the current event with a subtle pulse."
        },
        {
          "name": "children",
          "type": "ReactNode",
          "required": false,
          "description": "Optional icon rendered inside an icon-sized marker."
        }
      ]
    },
    {
      "name": "TimelineHeader",
      "props": []
    },
    {
      "name": "TimelineItem",
      "props": [
        {
          "name": "side",
          "type": "\"right\" | \"left\"",
          "required": false,
          "options": [
            "right",
            "left"
          ],
          "defaultValue": "right",
          "description": "Side used by alternate timelines."
        },
        {
          "name": "state",
          "type": "\"default\" | \"complete\" | \"current\" | \"upcoming\"",
          "required": false,
          "options": [
            "default",
            "complete",
            "current",
            "upcoming"
          ],
          "defaultValue": "default",
          "description": "Semantic progression state."
        }
      ]
    },
