{
  "name": "button",
  "type": "registry:ui",
  "title": "按钮 Button",
  "description": "显示一个按钮，或显示一个外观类似按钮的组件。",
  "import": "import { Button, buttonVariants } from \"@/components/ui/button\"",
  "exports": [
    "Button",
    "buttonVariants"
  ],
  "typeExports": [
    "ButtonProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/button",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/button.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"default\" | \"link\" | \"secondary\" | \"destructive\" | \"outline\" | \"ghost\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "link",
        "secondary",
        "destructive",
        "outline",
        "ghost"
      ],
      "defaultValue": "default",
      "description": "按钮的视觉样式。"
    },
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\" | \"icon\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg",
        "icon"
      ],
      "defaultValue": "default",
      "description": "按钮的高度和内边距。设置为 icon 时用于仅显示图标的方形按钮。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    },
    {
      "name": "motion",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否启用轻微的弹性按压和悬停动效。开启 prefers-reduced-motion 时会自动停用。"
    },
    {
      "name": "ripple",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否启用从指针位置向外扩散的点击涟漪效果。开启 prefers-reduced-motion 时会自动停用。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "events": "`Button` 会将 `{...props}` 展开到底层元素，因此支持所有原生按钮事件。\n\n  启用 `asChild` 后，事件会绑定到你渲染的子元素（例如 `<a>`），而不是 `<button>`。",
  "examples": [
    {
      "name": "button-demo",
      "title": "基础用法"
    },
    {
      "name": "button-variants",
      "title": "变体"
    },
    {
      "name": "button-sizes",
      "title": "尺寸"
    },
    {
      "name": "button-with-icon",
      "title": "搭配图标"
    },
    {
      "name": "button-loading",
      "title": "加载状态"
    },
    {
      "name": "button-link",
      "title": "链接变体（动态下划线）"
    },
    {
      "name": "button-as-child",
      "title": "作为链接（`asChild`）"
    },
    {
      "name": "button-motion",
      "title": "动效（可选）"
    },
    {
      "name": "button-ripple",
      "title": "涟漪（可选）"
    },
    {
      "name": "button-group-advanced"
    },
    {
      "name": "button-group-demo"
    }
  ],
  "files": [
    "registry/ui/button.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/button",
  "sourceUrl": "https://ui.wzx.wang/r/button.json"
}
