{
  "name": "kanban",
  "type": "registry:ui",
  "title": "看板 Kanban",
  "description": "用可组合列和原生拖放组织任务流转。",
  "import": "import { Kanban, KanbanCard, KanbanColumn, KanbanColumnBody, KanbanColumnCount, KanbanColumnHeader, KanbanColumnTitle } from \"@/components/ui/kanban\"",
  "exports": [
    "Kanban",
    "KanbanCard",
    "KanbanColumn",
    "KanbanColumnBody",
    "KanbanColumnCount",
    "KanbanColumnHeader",
    "KanbanColumnTitle"
  ],
  "typeExports": [
    "KanbanCardProps",
    "KanbanColumnProps",
    "KanbanMove",
    "KanbanProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/kanban",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/kanban.json",
    "npmDependencies": [
      "lucide-react"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "onMove",
      "type": "((move: KanbanMove) => void)",
      "required": false,
      "control": "text",
      "description": "卡片被拖入其他列后触发。"
    }
  ],
  "events": "卡片跨列放下时触发 `onMove({ itemId, from, to })`。每个 `KanbanColumn` 和 `KanbanCard` 都必须提供稳定的 `value`，\n业务层应在回调中更新数据，否则拖动结束后界面会回到原位置。原生拖拽事件仍可通过对应元素监听。",
  "examples": [
    {
      "name": "kanban-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/kanban.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/kanban",
  "sourceUrl": "https://ui.wzx.wang/r/kanban.json"
}
