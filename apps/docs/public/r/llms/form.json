{
  "name": "form",
  "type": "registry:ui",
  "title": "Form",
  "description": "可组合的表单字段，协调标签、校验提示与动效反馈。",
  "import": "import { Form, FormActions, FormControl, FormDescription, FormField, FormLabel, FormLegend, FormMessage, FormSection } from \"@/components/ui/form\"",
  "exports": [
    "Form",
    "FormActions",
    "FormControl",
    "FormDescription",
    "FormField",
    "FormLabel",
    "FormLegend",
    "FormMessage",
    "FormSection"
  ],
  "typeExports": [
    "FormControlProps",
    "FormFieldProps",
    "FormProps"
  ],
  "install": {
    "wui": "npx wui@latest add @wui/form",
    "shadcn": "npx shadcn@latest add http://localhost:3000/r/form.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "animated",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "挂载时是否播放表单入场动效。@default true"
    },
    {
      "name": "acceptCharset",
      "type": "string",
      "required": false,
      "control": "text"
    },
    {
      "name": "action",
      "type": "string | ((formData: FormData) => void | Promise<void>)",
      "required": false,
      "control": "text"
    },
    {
      "name": "autoComplete",
      "type": "string",
      "required": false,
      "control": "text"
    },
    {
      "name": "encType",
      "type": "string",
      "required": false,
      "control": "text"
    },
    {
      "name": "method",
      "type": "string",
      "required": false,
      "control": "text"
    },
    {
      "name": "noValidate",
      "type": "boolean",
      "required": false,
      "control": "boolean"
    },
    {
      "name": "target",
      "type": "string",
      "required": false,
      "control": "text"
    }
  ],
  "events": "- `Form` 会透传 `onSubmit`、`onReset` 和 `onInvalid` 等原生表单事件。\n- `FormControl` 保留子控件自身事件，同时补充字段 ID 和 ARIA 关联。\n- 修改 `FormField` 的 `invalid` 会显示紧邻控件的 `FormMessage`，并触发适配减少动态效果偏好的轻微纠正提示。",
  "examples": [
    {
      "name": "form-demo",
      "title": "基础示例"
    }
  ],
  "files": [
    "registry/ui/form.tsx"
  ],
  "docsUrl": "http://localhost:3000/docs/components/form",
  "sourceUrl": "http://localhost:3000/r/form.json"
}
