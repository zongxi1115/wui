{
  "name": "horizontal-scroll",
  "type": "registry:ui",
  "title": "横向滚动区块 Horizontal Scroll",
  "description": "将垂直滚动距离映射为钉住内容轨道的水平移动。",
  "categories": [
    "scroll",
    "motion"
  ],
  "import": "import { HorizontalScroll } from \"@/components/ui/horizontal-scroll\"",
  "exports": [
    "HorizontalScroll"
  ],
  "typeExports": [
    "HorizontalScrollProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/horizontal-scroll",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/horizontal-scroll.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "区块固定时沿水平方向移动的宽内容。"
    },
    {
      "name": "container",
      "type": "RefObject<HTMLElement | null>",
      "required": false,
      "control": "text",
      "description": "要监听的滚动容器；未设置时监听页面。"
    },
    {
      "name": "scrollPadding",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0",
      "description": "额外增加的垂直滚动距离，单位为像素。"
    },
    {
      "name": "viewportClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于固定视口的 CSS 类名。"
    },
    {
      "name": "trackClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于水平移动轨道的 CSS 类名。"
    }
  ],
  "usage": "直接子内容需要明确宽度并设置 `shrink-0`。不要把表单、长文本或需要大量垂直浏览的内容放进横向轨道。\n用户开启“减少动态效果”后，组件回退为普通的横向可滚动容器，内容仍然可访问。",
  "examples": [
    {
      "name": "horizontal-scroll-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/horizontal-scroll.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/horizontal-scroll",
  "sourceUrl": "https://ui.wzx.wang/r/horizontal-scroll.json"
}
