{
  "name": "scroll-sequence",
  "type": "registry:ui",
  "title": "滚动分步 Scroll Sequence",
  "description": "固定区块并用滚动进度逐步切换内部内容。",
  "categories": [
    "scroll",
    "motion"
  ],
  "import": "import { ScrollSequence } from \"@/components/ui/scroll-sequence\"",
  "exports": [
    "ScrollSequence"
  ],
  "typeExports": [
    "ScrollSequenceProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/scroll-sequence",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/scroll-sequence.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "固定视口中按顺序逐个显示的步骤内容。"
    },
    {
      "name": "stepLength",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.65",
      "description": "每次切换占用的滚动距离，以视口高度为单位。"
    },
    {
      "name": "container",
      "type": "RefObject<HTMLElement | null>",
      "required": false,
      "control": "text",
      "description": "要监听的滚动容器；未设置时监听页面。"
    },
    {
      "name": "showProgress",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否显示紧凑的步骤指示器。"
    },
    {
      "name": "onStepChange",
      "type": "((index: number) => void)",
      "required": false,
      "control": "text",
      "description": "当前步骤变化时触发。"
    },
    {
      "name": "viewportClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于固定视口的 CSS 类名。"
    },
    {
      "name": "stepClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于当前步骤包装元素的 CSS 类名。"
    }
  ],
  "usage": "每个步骤应表达一个独立状态，内容高度尽量稳定。`stepLength` 决定两个状态之间的滚动距离。用户开启“减少动态效果”时，\n所有步骤会恢复为普通纵向内容，避免用户必须依赖滚动动画才能读取信息。",
  "events": "`onStepChange(index)` 在活动步骤改变时触发，可用于同步外部导航、媒体时间点或分析事件。不要在回调中反向修改滚动位置，\n以免滚动位置和步骤状态互相触发更新。",
  "examples": [
    {
      "name": "scroll-sequence-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/scroll-sequence.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/scroll-sequence",
  "sourceUrl": "https://ui.wzx.wang/r/scroll-sequence.json"
}
