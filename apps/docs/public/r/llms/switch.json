{
  "name": "switch",
  "type": "registry:ui",
  "title": "开关 Switch",
  "description": "带弹簧滑块与完整无障碍语义的二元状态控件。",
  "import": "import { Switch, switchVariants } from \"@/components/ui/switch\"",
  "exports": [
    "Switch",
    "switchVariants"
  ],
  "typeExports": [
    "SwitchProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/switch",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/switch.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "开关的尺寸。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "- `onCheckedChange(checked)`：状态变化后触发，参数为新的布尔值；受控模式下需要同步更新 `checked`。\n- 原生焦点、键盘与表单属性会继续透传到底层 Radix Root。",
  "examples": [
    {
      "name": "switch-demo",
      "title": "基础用法"
    },
    {
      "name": "switch-sizes",
      "title": "尺寸"
    }
  ],
  "files": [
    "registry/ui/switch.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/switch",
  "sourceUrl": "https://ui.wzx.wang/r/switch.json"
}
