{
  "name": "motion",
  "type": "registry:ui",
  "title": "动效 Motion",
  "description": "基于 motion 构建的可选动画基础组件和预设库。",
  "import": "import { Motion, motionPresets, motionTransitions } from \"@/components/ui/motion\"",
  "exports": [
    "Motion",
    "motionPresets",
    "motionTransitions"
  ],
  "typeExports": [
    "MotionPreset",
    "MotionProps",
    "MotionTransition"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/motion",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/motion.json",
    "npmDependencies": [
      "motion",
      "radix-ui"
    ],
    "registryDependencies": []
  },
  "props": [
    {
      "name": "preset",
      "type": "\"pop\" | \"scale\" | \"fade\" | \"slide-up\" | \"slide-down\" | \"slide-left\" | \"slide-right\" | \"blur\"",
      "required": false,
      "control": "select",
      "options": [
        "pop",
        "scale",
        "fade",
        "slide-up",
        "slide-down",
        "slide-left",
        "slide-right",
        "blur"
      ],
      "defaultValue": "fade",
      "description": "入场动画的预设名称。"
    },
    {
      "name": "transition",
      "type": "Transition | \"smooth\" | \"spring\" | \"snappy\"",
      "required": false,
      "control": "text",
      "defaultValue": "smooth",
      "description": "预设过渡动画，或自定义的 Motion Transition 配置。"
    },
    {
      "name": "delay",
      "type": "number",
      "required": false,
      "control": "number",
      "description": "开始播放动画前等待的时间，单位为秒。"
    },
    {
      "name": "inView",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否在内容进入视口时播放动画，而不是挂载后立即播放。"
    },
    {
      "name": "once",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否只在内容第一次进入视口时播放动画。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "examples": [
    {
      "name": "motion-demo",
      "title": "基础用法"
    },
    {
      "name": "motion-presets",
      "title": "动画预设"
    },
    {
      "name": "motion-in-view",
      "title": "滚动进入视口时播放（`inView`）"
    },
    {
      "name": "motion-as-child",
      "title": "为现有组件添加动画（`asChild`）"
    }
  ],
  "files": [
    "registry/ui/motion.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/motion",
  "sourceUrl": "https://ui.wzx.wang/r/motion.json"
}
