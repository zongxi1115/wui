{
  "name": "stacked-bar-chart",
  "type": "registry:component",
  "title": "堆叠条形图 Stacked Bar Chart",
  "description": "比较分类总量及其组成，支持横向、纵向与百分比堆叠。",
  "categories": [
    "charts",
    "comparison",
    "composition"
  ],
  "import": "import { StackedBarChart } from \"@/components/charts/stacked-bar-chart\"",
  "exports": [
    "StackedBarChart"
  ],
  "typeExports": [
    "ChartDatum",
    "ChartLabelFormatter",
    "ChartSeries",
    "ChartValueFormatter",
    "StackedBarChartProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/stacked-bar-chart",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/stacked-bar-chart.json",
    "npmDependencies": [],
    "registryDependencies": [
      "chart-core"
    ]
  },
  "props": [
    {
      "name": "title",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "图表标题，用于说明正在比较的总量或构成。"
    },
    {
      "name": "description",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "补充单位、时间范围或分母口径；应说明一梯级代表多少单位。"
    },
    {
      "name": "actions",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "标题右侧的操作区。"
    },
    {
      "name": "variant",
      "type": "\"mono\" | \"porcelain\" | \"palm\" | \"wire\"",
      "required": false,
      "control": "select",
      "options": [
        "mono",
        "porcelain",
        "palm",
        "wire"
      ],
      "defaultValue": "mono",
      "description": "Lieflat 色彩系统；并列构成且不超过四类时可用 palm。"
    },
    {
      "name": "source",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "模板来源行，例如“STACKED RUNGS · REVENUE MIX · BILLING”。"
    },
    {
      "name": "data",
      "type": "ChartDatum[]",
      "required": true,
      "control": "text",
      "description": "每行代表一个分类的数据。"
    },
    {
      "name": "categoryKey",
      "type": "string",
      "required": true,
      "control": "text",
      "description": "分类名称字段。"
    },
    {
      "name": "series",
      "type": "ChartSeries[]",
      "required": true,
      "control": "text",
      "description": "参与堆叠的数值序列，F7 最多四段。"
    },
    {
      "name": "layout",
      "type": "\"horizontal\" | \"vertical\"",
      "required": false,
      "control": "select",
      "options": [
        "horizontal",
        "vertical"
      ],
      "description": "F7 为纵向梯级堆叠；该属性仅为兼容旧调用保留。"
    },
    {
      "name": "normalize",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否把每个分类归一化为百分比。"
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "300",
      "description": "图表绘图区高度，单位为像素。"
    },
    {
      "name": "labelWidth",
      "type": "number",
      "required": false,
      "control": "number",
      "description": "保留以兼容旧调用。"
    },
    {
      "name": "showGrid",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "保留以兼容旧调用。"
    },
    {
      "name": "showLegend",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否显示图例。"
    },
    {
      "name": "showValues",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否在每段旁显示数值。"
    },
    {
      "name": "rungStep",
      "type": "number",
      "required": false,
      "control": "number",
      "description": "每一横档代表的真实数值；省略时按数据自动取易读单位。"
    },
    {
      "name": "valueFormatter",
      "type": "ChartValueFormatter",
      "required": false,
      "control": "text",
      "defaultValue": "(value) => defaultValueFormatter(value)",
      "description": "自定义原始数值的显示格式。"
    },
    {
      "name": "labelFormatter",
      "type": "ChartLabelFormatter",
      "required": false,
      "control": "text",
      "defaultValue": "(label) => String(label)",
      "description": "自定义分类标签。"
    },
    {
      "name": "onValueSelect",
      "type": "((datum: ChartDatum, series: ChartSeries, value: number) => void)",
      "required": false,
      "control": "text",
      "description": "点击某个堆叠段时触发。"
    }
  ],
  "examples": [
    {
      "name": "stacked-bar-chart-demo"
    }
  ],
  "files": [
    "registry/charts/stacked-bar-chart.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/charts/stacked-bar-chart",
  "sourceUrl": "https://ui.wzx.wang/r/stacked-bar-chart.json"
}
