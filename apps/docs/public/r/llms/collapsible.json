{
  "name": "collapsible",
  "type": "registry:ui",
  "title": "折叠面板 Collapsible",
  "description": "按需展开一段补充内容，并保留清晰的状态与键盘交互。",
  "categories": [
    "layout"
  ],
  "import": "import { Collapsible, CollapsibleContent, CollapsibleTrigger } from \"@/components/ui/collapsible\"",
  "exports": [
    "Collapsible",
    "CollapsibleContent",
    "CollapsibleTrigger"
  ],
  "typeExports": [
    "CollapsibleProps",
    "CollapsibleTriggerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/collapsible",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/collapsible.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "- `onOpenChange(open)`：用户点击触发器，或受控状态被更新时触发。\n- 触发器使用原生按钮语义，支持 Enter 与 Space，并同步 `aria-expanded` 和内容关联关系。",
  "examples": [
    {
      "name": "collapsible-demo",
      "title": "基础用法"
    },
    {
      "name": "collapsible-controlled",
      "title": "受控状态"
    }
  ],
  "files": [
    "registry/ui/collapsible.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/collapsible",
  "sourceUrl": "https://ui.wzx.wang/r/collapsible.json"
}
