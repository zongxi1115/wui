{
  "name": "pagination",
  "type": "registry:ui",
  "title": "分页 Pagination",
  "description": "用于在海量数据或长列表中实现按页加载与分段导航，清晰传达当前页码、总页数及折叠区间。",
  "categories": [
    "navigation"
  ],
  "import": "import { Pagination, PaginationContent, PaginationCounter, PaginationEllipsis, PaginationItem, PaginationLink, PaginationNext, PaginationPrevious } from \"@/components/ui/pagination\"",
  "exports": [
    "Pagination",
    "PaginationContent",
    "PaginationCounter",
    "PaginationEllipsis",
    "PaginationItem",
    "PaginationLink",
    "PaginationNext",
    "PaginationPrevious"
  ],
  "typeExports": [
    "PaginationCounterProps",
    "PaginationLinkProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/pagination",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/pagination.json",
    "npmDependencies": [
      "lucide-react",
      "radix-ui",
      "motion"
    ],
    "registryDependencies": [
      "utils",
      "button"
    ]
  },
  "props": [],
  "examples": [
    {
      "name": "pagination-demo",
      "title": "基础用法"
    },
    {
      "name": "pagination-table",
      "title": "完整业务表格分页条"
    },
    {
      "name": "pagination-advanced",
      "title": "页码窗口平移"
    },
    {
      "name": "pagination-sizes",
      "title": "尺寸预设"
    },
    {
      "name": "pagination-simple",
      "title": "简洁分页"
    }
  ],
  "files": [
    "registry/ui/pagination.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/pagination",
  "sourceUrl": "https://ui.wzx.wang/r/pagination.json"
}
