{
  "name": "pagination",
  "type": "registry:ui",
  "title": "分页 Pagination",
  "description": "在分页数据之间导航，并清晰标记当前页和省略的页码区间。",
  "categories": [
    "navigation"
  ],
  "import": "import { Pagination, PaginationContent, PaginationEllipsis, PaginationItem, PaginationLink, PaginationNext, PaginationPrevious } from \"@/components/ui/pagination\"",
  "exports": [
    "Pagination",
    "PaginationContent",
    "PaginationEllipsis",
    "PaginationItem",
    "PaginationLink",
    "PaginationNext",
    "PaginationPrevious"
  ],
  "typeExports": [
    "PaginationLinkProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/pagination",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/pagination.json",
    "npmDependencies": [
      "lucide-react",
      "radix-ui"
    ],
    "registryDependencies": [
      "utils",
      "button"
    ]
  },
  "props": [],
  "examples": [
    {
      "name": "pagination-demo",
      "title": "基础用法"
    },
    {
      "name": "pagination-advanced",
      "title": "受控页码与省略项"
    }
  ],
  "files": [
    "registry/ui/pagination.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/pagination",
  "sourceUrl": "https://ui.wzx.wang/r/pagination.json"
}
