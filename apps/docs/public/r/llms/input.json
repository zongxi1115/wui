{
  "name": "input",
  "type": "registry:ui",
  "title": "输入框 Input",
  "description": "支持前后内容、浮动标签、下划线和错误态的输入框。",
  "import": "import { Input, inputShellVariants } from \"@/components/ui/input\"",
  "exports": [
    "Input",
    "inputShellVariants"
  ],
  "typeExports": [
    "InputProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/input",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/input.json",
    "npmDependencies": [
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"default\" | \"underline\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "underline"
      ],
      "defaultValue": "default",
      "description": "输入框的外观样式。"
    },
    {
      "name": "visualSize",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "输入框的视觉尺寸。"
    },
    {
      "name": "label",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "输入框获得焦点或有值前显示在输入区域内的浮动标签。"
    },
    {
      "name": "startContent",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "显示在输入内容前的装饰或操作内容。"
    },
    {
      "name": "endContent",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "显示在输入内容后的装饰或操作内容。"
    },
    {
      "name": "wrapperClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于最外层容器的额外 CSS 类名。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "events": "所有原生输入事件都会透传，包括 `onChange`、`onInput`、`onFocus`、`onBlur` 和键盘事件。传入 `aria-invalid=\"true\"`\n会同步显示错误边框和错误状态；错误原因仍应通过表单说明文字提供，不能只依赖颜色。",
  "examples": [
    {
      "name": "input-demo",
      "title": "基础用法"
    },
    {
      "name": "input-states",
      "title": "图标、错误与禁用态"
    },
    {
      "name": "input-floating-label",
      "title": "浮动标签"
    },
    {
      "name": "input-underline",
      "title": "下划线样式"
    }
  ],
  "files": [
    "registry/ui/input.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/input",
  "sourceUrl": "https://ui.wzx.wang/r/input.json"
}
