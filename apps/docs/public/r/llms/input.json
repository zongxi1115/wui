{
  "name": "input",
  "type": "registry:ui",
  "title": "输入框 Input",
  "description": "用于录入单行文本、邮箱、密码及搜索词的基础表单控件，支持前后置内容、浮动标签、下划线风格与多重校验状态。",
  "import": "import { Input, inputShellVariants } from \"@/components/ui/input\"",
  "exports": [
    "Input",
    "inputShellVariants"
  ],
  "typeExports": [
    "InputProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/input",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/input.json",
    "npmDependencies": [
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"default\" | \"underline\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "underline"
      ],
      "defaultValue": "default",
      "description": "输入框的外观样式。"
    },
    {
      "name": "visualSize",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "输入框的视觉尺寸。"
    },
    {
      "name": "label",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "输入框获得焦点或有值前显示在输入区域内的浮动标签。"
    },
    {
      "name": "startContent",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "显示在输入内容前的装饰或操作内容。"
    },
    {
      "name": "endContent",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "显示在输入内容后的装饰或操作内容。"
    },
    {
      "name": "wrapperClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于最外层容器的额外 CSS 类名。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "examples": [
    {
      "name": "input-demo",
      "title": "基础用法"
    },
    {
      "name": "input-controlled",
      "title": "受控模式与字符统计"
    },
    {
      "name": "input-sizes",
      "title": "尺寸规格"
    },
    {
      "name": "input-with-icon",
      "title": "前后置图标与操作 (Start & End Content)"
    },
    {
      "name": "input-password",
      "title": "密码输入与强度检测"
    },
    {
      "name": "input-floating-label",
      "title": "浮动标签 (Floating Label)"
    },
    {
      "name": "input-underline",
      "title": "下划线风格 (Underline Variant)"
    },
    {
      "name": "input-states",
      "title": "状态展示与表单校验"
    },
    {
      "name": "input-form",
      "title": "完整业务表单"
    },
    {
      "name": "input-number-advanced"
    },
    {
      "name": "input-number-controlled"
    },
    {
      "name": "input-number-demo"
    },
    {
      "name": "input-number-disabled"
    },
    {
      "name": "input-number-form"
    },
    {
      "name": "input-number-sizes"
    },
    {
      "name": "input-otp-advanced"
    },
    {
      "name": "input-otp-alphanumeric"
    },
    {
      "name": "input-otp-auth-flow"
    },
    {
      "name": "input-otp-demo"
    },
    {
      "name": "input-otp-pin"
    }
  ],
  "files": [
    "registry/ui/input.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/input",
  "sourceUrl": "https://ui.wzx.wang/r/input.json"
}
