{
  "name": "sliding-number",
  "type": "registry:ui",
  "title": "滑动数字 Sliding Number",
  "description": "用独立数字轮平滑过渡数值变化。",
  "categories": [
    "motion",
    "number-effect"
  ],
  "import": "import { SlidingNumber } from \"@/components/ui/sliding-number\"",
  "exports": [
    "SlidingNumber"
  ],
  "typeExports": [
    "SlidingNumberProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/sliding-number",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/sliding-number.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "value",
      "type": "string | number",
      "required": true,
      "control": "text",
      "description": "要显示的数字或数字字符串。"
    },
    {
      "name": "padStart",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否为一位整数补充前导零。"
    },
    {
      "name": "decimalSeparator",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": ".",
      "description": "替代小数点显示的字符。"
    },
    {
      "name": "transition",
      "type": "Transition",
      "required": false,
      "control": "text",
      "defaultValue": "{\n  type: \"spring\",\n  stiffness: 260,\n  damping: 28,\n}",
      "description": "每个数字滚轮使用的过渡动画。"
    }
  ],
  "events": "组件没有自有事件，并透传 `<span>` 的原生事件。修改 `value` 即会触发过渡；用户开启“减少动态效果”时数位立即更新。",
  "examples": [
    {
      "name": "sliding-number-demo",
      "title": "基础用法"
    },
    {
      "name": "sliding-number-clock",
      "title": "时钟"
    }
  ],
  "files": [
    "registry/ui/sliding-number.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/sliding-number",
  "sourceUrl": "https://ui.wzx.wang/r/sliding-number.json"
}
