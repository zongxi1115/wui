{
  "name": "ai-tool",
  "type": "registry:ui",
  "title": "AI 工具调用 AI Tool",
  "description": "展示 AI 工具的执行状态、参数、结果与错误。",
  "categories": [
    "ai"
  ],
  "import": "import { AiTool, AiToolCode, AiToolContent, AiToolError, AiToolLabel, AiToolSection, AiToolStatus, AiToolTrigger, aiToolStatusVariants } from \"@/components/ui/ai-tool\"",
  "exports": [
    "AiTool",
    "AiToolCode",
    "AiToolContent",
    "AiToolError",
    "AiToolLabel",
    "AiToolSection",
    "AiToolStatus",
    "AiToolTrigger",
    "aiToolStatusVariants"
  ],
  "typeExports": [
    "AiToolProps",
    "AiToolStatus",
    "AiToolStatusProps",
    "AiToolTriggerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/ai-tool",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/ai-tool.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority",
      "lucide-react"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "status",
      "type": "\"error\" | \"pending\" | \"approval\" | \"running\" | \"success\" | \"denied\"",
      "required": false,
      "control": "select",
      "options": [
        "error",
        "pending",
        "approval",
        "running",
        "success",
        "denied"
      ],
      "defaultValue": "pending",
      "description": "工具调用的当前状态，例如执行中、成功或失败。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "组件透传 Radix Collapsible 的 `open`、`defaultOpen` 和 `onOpenChange`，支持受控和非受控展开。工具批准、拒绝和重试按钮\n由业务层放入 `AiToolSection`，并自行绑定请求事件；按钮的显示条件应与当前工具状态保持一致。",
  "examples": [
    {
      "name": "ai-tool-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/ai-tool.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/ai-tool",
  "sourceUrl": "https://ui.wzx.wang/r/ai-tool.json"
}
