{
  "name": "avatar",
  "type": "registry:ui",
  "title": "头像 Avatar",
  "description": "带图片回退、在线状态和头像组的通用身份组件。",
  "import": "import { Avatar, AvatarBadge, AvatarFallback, AvatarGroup, AvatarGroupCount, AvatarImage, avatarBadgeVariants, avatarVariants } from \"@/components/ui/avatar\"",
  "exports": [
    "Avatar",
    "AvatarBadge",
    "AvatarFallback",
    "AvatarGroup",
    "AvatarGroupCount",
    "AvatarImage",
    "avatarBadgeVariants",
    "avatarVariants"
  ],
  "typeExports": [
    "AvatarBadgeProps",
    "AvatarGroupCountProps",
    "AvatarProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/avatar",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/avatar.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\" | \"xs\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg",
        "xs"
      ],
      "defaultValue": "default",
      "description": "头像尺寸。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "`AvatarImage` 会透传图片的加载事件和 `ref`；`Avatar`、`AvatarFallback` 以及分组部件会透传对应原生元素属性。\n在线状态由业务层传给 `AvatarBadge status`，组件不会请求接口或自行轮询用户状态。",
  "examples": [
    {
      "name": "avatar-demo",
      "title": "基础用法"
    },
    {
      "name": "avatar-group",
      "title": "头像组"
    }
  ],
  "files": [
    "registry/ui/avatar.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/avatar",
  "sourceUrl": "https://ui.wzx.wang/r/avatar.json"
}
