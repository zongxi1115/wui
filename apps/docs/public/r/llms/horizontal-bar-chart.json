{
  "name": "horizontal-bar-chart",
  "type": "registry:component",
  "title": "横向条形图 Horizontal Bar Chart",
  "description": "为长分类标签和排名比较保留充足的水平阅读空间。",
  "categories": [
    "charts",
    "comparison"
  ],
  "import": "import { HorizontalBarChart } from \"@/components/charts/horizontal-bar-chart\"",
  "exports": [
    "HorizontalBarChart"
  ],
  "typeExports": [
    "ChartDatum",
    "ChartLabelFormatter",
    "ChartSeries",
    "ChartValueFormatter",
    "HorizontalBarChartProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/horizontal-bar-chart",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/horizontal-bar-chart.json",
    "npmDependencies": [],
    "registryDependencies": [
      "stacked-bar-chart"
    ]
  },
  "props": [
    {
      "name": "title",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "结论式标题，而不是“横向条形图”等图型名称。"
    },
    {
      "name": "description",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "单位、刻度含义和时间范围。"
    },
    {
      "name": "actions",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "标题右侧操作区。"
    },
    {
      "name": "variant",
      "type": "\"mono\" | \"porcelain\" | \"palm\" | \"wire\"",
      "required": false,
      "control": "select",
      "options": [
        "mono",
        "porcelain",
        "palm",
        "wire"
      ],
      "defaultValue": "mono",
      "description": "Lieflat 色彩系统。排名和较多类目默认使用 mono。"
    },
    {
      "name": "source",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "模板来源行，例如“TICK ROWS · RELEASE LOG · ENGINEERING”。"
    },
    {
      "name": "data",
      "type": "ChartDatum[]",
      "required": true,
      "control": "text",
      "description": "每行代表一个可比较类别。最多建议八行。"
    },
    {
      "name": "categoryKey",
      "type": "string",
      "required": true,
      "control": "text",
      "description": "类别标签字段。"
    },
    {
      "name": "series",
      "type": "[ChartSeries]",
      "required": true,
      "control": "text",
      "description": "单一数值序列；一行只编码一个真实指标。"
    },
    {
      "name": "tickStep",
      "type": "number",
      "required": false,
      "control": "number",
      "description": "每一根 tick 所代表的真实单位；未传时按最大值推导可读刻度。"
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "320",
      "description": "图表绘图区高度，单位为像素。"
    },
    {
      "name": "labelWidth",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "120",
      "description": "标签列宽度，单位为像素。"
    },
    {
      "name": "showValues",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否显示行尾精确值。"
    },
    {
      "name": "valueFormatter",
      "type": "ChartValueFormatter",
      "required": false,
      "control": "text",
      "defaultValue": "(value) => defaultValueFormatter(value)",
      "description": "自定义数值显示格式。"
    },
    {
      "name": "labelFormatter",
      "type": "ChartLabelFormatter",
      "required": false,
      "control": "text",
      "defaultValue": "(value) => String(value)",
      "description": "自定义类别标签。"
    }
  ],
  "examples": [
    {
      "name": "horizontal-bar-chart-demo"
    }
  ],
  "files": [
    "registry/charts/horizontal-bar-chart.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/charts/horizontal-bar-chart",
  "sourceUrl": "https://ui.wzx.wang/r/horizontal-bar-chart.json"
}
