{
  "name": "combobox",
  "type": "registry:ui",
  "title": "组合选择器 Combobox",
  "description": "将输入搜索与单选列表组合在一起的可搜索选择器。",
  "import": "import { Combobox } from \"@/components/ui/combobox\"",
  "exports": [
    "Combobox"
  ],
  "typeExports": [
    "ComboboxOption",
    "ComboboxProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/combobox",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/combobox.json",
    "npmDependencies": [
      "lucide-react"
    ],
    "registryDependencies": [
      "utils",
      "command",
      "popover"
    ]
  },
  "props": [
    {
      "name": "options",
      "type": "ComboboxOption[]",
      "required": true,
      "control": "text",
      "description": "可搜索的选项集合。"
    },
    {
      "name": "value",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "受控模式下的选中值。"
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "非受控模式下的初始选中值。"
    },
    {
      "name": "onValueChange",
      "type": "((value: string) => void)",
      "required": false,
      "control": "text",
      "description": "选中值变化或清空时触发。"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "请选择",
      "description": "未选中时显示的文本。@default \"请选择\""
    },
    {
      "name": "searchPlaceholder",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "搜索选项",
      "description": "搜索框占位文本。@default \"搜索选项\""
    },
    {
      "name": "emptyText",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "defaultValue": "没有匹配的选项",
      "description": "没有匹配项时显示的文本。@default \"没有匹配的选项\""
    },
    {
      "name": "clearable",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否显示清空按钮。@default true"
    },
    {
      "name": "contentClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于浮层的额外类名。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "events": "- `onValueChange(value)` 在选中或清空时触发，清空时返回空字符串。\n- 传入 `value` 后组件进入受控模式；仅需要初始值时使用 `defaultValue`。",
  "examples": [
    {
      "name": "combobox-demo",
      "title": "基础用法"
    },
    {
      "name": "combobox-controlled",
      "title": "受控值、拼音搜索与禁用项"
    }
  ],
  "files": [
    "registry/ui/combobox.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/combobox",
  "sourceUrl": "https://ui.wzx.wang/r/combobox.json"
}
