{
  "name": "sticky-stack",
  "type": "registry:ui",
  "title": "粘性层叠卡片 Sticky Stack",
  "description": "卡片在向下滚动时依次吸顶、层叠堆积并微弱退后缩小的多层视觉递进组件。",
  "categories": [
    "scroll",
    "motion"
  ],
  "import": "import { StickyStack, StickyStackItem } from \"@/components/ui/sticky-stack\"",
  "exports": [
    "StickyStack",
    "StickyStackItem"
  ],
  "typeExports": [
    "StickyStackItemProps",
    "StickyStackProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/sticky-stack",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/sticky-stack.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "按堆叠顺序渲染的 StickyStackItem 元素。"
    },
    {
      "name": "top",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "24",
      "description": "第一个粘性项目距离顶部的偏移量，单位为像素。"
    },
    {
      "name": "gap",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "12",
      "description": "堆叠项目之间仍可见的垂直偏移量，单位为像素。"
    },
    {
      "name": "scaleStep",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.035",
      "description": "每有一张卡片位于当前项目上方时减少的缩放比例。"
    },
    {
      "name": "container",
      "type": "RefObject<HTMLElement | null>",
      "required": false,
      "control": "text",
      "description": "要监听的滚动容器；未设置时监听页面。"
    }
  ],
  "examples": [
    {
      "name": "sticky-stack-demo",
      "title": "基础用法"
    },
    {
      "name": "sticky-stack-features",
      "title": "RAG 知识库流水线执行阶段"
    }
  ],
  "files": [
    "registry/ui/sticky-stack.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/sticky-stack",
  "sourceUrl": "https://ui.wzx.wang/r/sticky-stack.json"
}
