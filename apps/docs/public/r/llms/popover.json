{
  "name": "popover",
  "type": "registry:ui",
  "title": "气泡浮层 Popover",
  "description": "在指定触发锚点周围展示富文本内容、轻量表单或操作卡片，支持自动碰撞避让与完整的焦点管理。",
  "import": "import { Popover, PopoverAnchor, PopoverClose, PopoverContent, PopoverDescription, PopoverPortal, PopoverTitle, PopoverTrigger } from \"@/components/ui/popover\"",
  "exports": [
    "Popover",
    "PopoverAnchor",
    "PopoverClose",
    "PopoverContent",
    "PopoverDescription",
    "PopoverPortal",
    "PopoverTitle",
    "PopoverTrigger"
  ],
  "typeExports": [
    "PopoverContentProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/popover",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/popover.json",
    "npmDependencies": [
      "radix-ui"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [],
  "examples": [
    {
      "name": "popover-demo",
      "title": "基础用法"
    },
    {
      "name": "popover-filter",
      "title": "快捷筛选与多选条件面板"
    },
    {
      "name": "popover-form",
      "title": "轻量配置与表单输入"
    }
  ],
  "files": [
    "registry/ui/popover.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/popover",
  "sourceUrl": "https://ui.wzx.wang/r/popover.json"
}
