{
  "name": "kbd",
  "type": "registry:ui",
  "title": "键盘提示 Kbd",
  "description": "用紧凑、克制的按键样式展示快捷键与键盘操作。",
  "import": "import { Kbd, KbdGroup, kbdVariants } from \"@/components/ui/kbd\"",
  "exports": [
    "Kbd",
    "KbdGroup",
    "kbdVariants"
  ],
  "typeExports": [
    "KbdProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/kbd",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/kbd.json",
    "npmDependencies": [
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "size",
      "type": "\"default\" | \"sm\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm"
      ],
      "defaultValue": "default",
      "description": "键盘按键提示的尺寸。"
    }
  ],
  "events": "键盘提示本身不触发操作，但原生属性仍会透传。需要响应快捷键时，应在页面或功能逻辑中注册键盘事件，\n并同时处理输入框、编辑器等不应拦截快捷键的场景。",
  "examples": [
    {
      "name": "kbd-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/kbd.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/kbd",
  "sourceUrl": "https://ui.wzx.wang/r/kbd.json"
}
