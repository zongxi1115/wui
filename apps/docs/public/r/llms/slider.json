{
  "name": "slider",
  "type": "registry:ui",
  "title": "滑动输入 Slider",
  "description": "粗轨道、小圆点滑块与数值标签组合的可调输入控件。",
  "import": "import { Slider, sliderTrackVariants } from \"@/components/ui/slider\"",
  "exports": [
    "Slider",
    "sliderTrackVariants"
  ],
  "typeExports": [
    "SliderProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/slider",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/slider.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"default\" | \"expand\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "expand"
      ],
      "defaultValue": "default",
      "description": "轨道的默认或交互展开样式。"
    },
    {
      "name": "showValue",
      "type": "\"always\" | \"hover\" | \"never\"",
      "required": false,
      "control": "select",
      "options": [
        "always",
        "hover",
        "never"
      ],
      "defaultValue": "hover",
      "description": "控制数值标签的显示时机。"
    },
    {
      "name": "formatValue",
      "type": "((value: number) => ReactNode)",
      "required": false,
      "control": "text",
      "defaultValue": "(current) => current",
      "description": "格式化滑块手柄上方显示的数值。"
    },
    {
      "name": "marks",
      "type": "number[]",
      "required": false,
      "control": "text",
      "defaultValue": "[]",
      "description": "在轨道上显示为圆点的刻度值数组。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "`onValueChange(values)` 会在拖动或键盘调整期间连续触发，适合实时更新预览；需要只在操作完成后提交时使用\n`onValueCommit(values)`。组件支持受控和非受控用法，范围模式下回调始终返回数值数组。",
  "examples": [
    {
      "name": "slider-demo",
      "title": "基础用法"
    },
    {
      "name": "slider-expand",
      "title": "交互状态与范围"
    }
  ],
  "files": [
    "registry/ui/slider.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/slider",
  "sourceUrl": "https://ui.wzx.wang/r/slider.json"
}
