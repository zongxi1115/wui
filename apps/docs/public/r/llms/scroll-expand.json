{
  "name": "scroll-expand",
  "type": "registry:ui",
  "title": "滚动扩展 Scroll Expand",
  "description": "将图片、视频或首屏从小画框滚动扩展到满屏，也可反向收拢。",
  "categories": [
    "scroll",
    "motion"
  ],
  "import": "import { ScrollExpand } from \"@/components/ui/scroll-expand\"",
  "exports": [
    "ScrollExpand"
  ],
  "typeExports": [
    "ScrollExpandProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/scroll-expand",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/scroll-expand.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "固定视口中随滚动展开或收拢的媒体或首屏内容。"
    },
    {
      "name": "direction",
      "type": "\"expand\" | \"collapse\"",
      "required": false,
      "control": "select",
      "options": [
        "expand",
        "collapse"
      ],
      "defaultValue": "expand",
      "description": "视觉变换跟随的滚动方向。"
    },
    {
      "name": "inset",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "10",
      "description": "紧凑状态下四条边的初始内缩比例。"
    },
    {
      "name": "radius",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "28",
      "description": "紧凑状态下的圆角半径，单位为像素。"
    },
    {
      "name": "scrollLength",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "1.8",
      "description": "区块占用的视口高度数量。"
    },
    {
      "name": "container",
      "type": "RefObject<HTMLElement | null>",
      "required": false,
      "control": "text",
      "description": "要监听的滚动容器；未设置时监听页面。"
    },
    {
      "name": "viewportClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于固定视口的 CSS 类名。"
    },
    {
      "name": "frameClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于变换内容画框的 CSS 类名。"
    }
  ],
  "usage": "子元素应填满组件尺寸，并自行使用 `object-cover` 或等价布局。`inset` 控制紧凑状态留白，`radius` 控制该状态的圆角，\n`scrollLength` 决定变化节奏。若内容中包含视频，仍需提供原生播放控制、字幕和暂停方式，不能只依靠滚动驱动播放。",
  "examples": [
    {
      "name": "scroll-expand-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/scroll-expand.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/scroll-expand",
  "sourceUrl": "https://ui.wzx.wang/r/scroll-expand.json"
}
