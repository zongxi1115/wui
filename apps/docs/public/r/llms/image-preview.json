{
  "name": "image-preview",
  "type": "registry:ui",
  "title": "图片预览 Image Preview",
  "description": "点击缩略图进入沉浸式大图预览，并提供缩放、旋转与下载操作。",
  "import": "import { ImagePreview } from \"@/components/ui/image-preview\"",
  "exports": [
    "ImagePreview"
  ],
  "typeExports": [
    "ImagePreviewProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/image-preview",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/image-preview.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "src",
      "type": "string",
      "required": true,
      "control": "text",
      "description": "缩略图和大图预览共用的图片地址。"
    },
    {
      "name": "alt",
      "type": "string",
      "required": true,
      "control": "text",
      "description": "图片的无障碍描述。"
    },
    {
      "name": "previewSrc",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "仅用于大图预览的高清图片地址。"
    },
    {
      "name": "caption",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "展开预览后显示在图片下方的说明文字。"
    },
    {
      "name": "open",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "受控模式下预览是否打开。"
    },
    {
      "name": "defaultOpen",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "非受控模式下预览的初始打开状态。"
    },
    {
      "name": "onOpenChange",
      "type": "((open: boolean) => void)",
      "required": false,
      "control": "text",
      "description": "预览打开或关闭时触发。"
    },
    {
      "name": "minZoom",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.5",
      "description": "允许使用的最小缩放比例。"
    },
    {
      "name": "maxZoom",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "3",
      "description": "允许使用的最大缩放比例。"
    },
    {
      "name": "zoomStep",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.25",
      "description": "每次缩放增加或减少的比例。"
    },
    {
      "name": "showToolbar",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否显示缩放、旋转、重置和可选的下载操作。"
    },
    {
      "name": "downloadName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "下载时使用的文件名。设置后会显示下载操作。"
    },
    {
      "name": "thumbnailClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于缩略图的额外 CSS 类名。"
    },
    {
      "name": "previewClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于展开图片的额外 CSS 类名。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "events": "- `onOpenChange(open)`：预览打开或关闭时触发，支持受控和非受控状态。\n- 缩放按钮也支持 `+`、`-` 快捷键，按 `0` 重置缩放和旋转。\n- Escape、背景点击和焦点管理会关闭或约束预览；放大后可以拖动图片查看边缘细节。\n- 其余按钮属性会透传给缩略图触发器。",
  "examples": [
    {
      "name": "image-preview-demo",
      "title": "基础用法"
    },
    {
      "name": "image-preview-minimal",
      "title": "简洁预览"
    }
  ],
  "files": [
    "registry/ui/image-preview.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/image-preview",
  "sourceUrl": "https://ui.wzx.wang/r/image-preview.json"
}
