{
  "name": "annotation",
  "type": "registry:ui",
  "title": "动态标注 Annotation",
  "description": "用路径箭头、荧光笔和自定义手绘轨迹强调页面内容。",
  "categories": [
    "fancy",
    "motion"
  ],
  "import": "import { AnnotationHighlight, AnnotationPath } from \"@/components/ui/annotation\"",
  "exports": [
    "AnnotationHighlight",
    "AnnotationPath"
  ],
  "typeExports": [
    "AnnotationHighlightProps",
    "AnnotationPathProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/annotation",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/annotation.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "显示在标注线条上方的行内内容。"
    },
    {
      "name": "variant",
      "type": "\"smooth\" | \"rough\"",
      "required": false,
      "control": "select",
      "options": [
        "smooth",
        "rough"
      ],
      "defaultValue": "smooth",
      "description": "标注线条的形状。"
    },
    {
      "name": "color",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "oklch(0.88 0.16 92 / 0.58)",
      "description": "标注线条的颜色。"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.65",
      "description": "线条扫过内容一次所需的时间，单位为秒。"
    },
    {
      "name": "delay",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0",
      "description": "开始高亮前等待的时间，单位为秒。"
    },
    {
      "name": "inView",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否在内容进入视口时开始高亮。"
    },
    {
      "name": "once",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否只在内容第一次进入视口时高亮。"
    }
  ],
  "usage": "路径坐标需要与 `viewBox` 使用同一套坐标系；自定义轨迹时建议保留少量外围空间，避免笔触或箭头被裁切。两种组件默认在进入视口时播放一次，\n也可以设置 `inView={false}` 在挂载时播放，或设置 `once={false}` 在每次进入视口时重播。\n\n荧光笔更适合单行短语。需要强调多行内容时，建议拆成多个短语分别标注，避免笔触跨行后失去手写感，也避免遮挡正文。",
  "examples": [
    {
      "name": "annotation-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/annotation.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/annotation",
  "sourceUrl": "https://ui.wzx.wang/r/annotation.json"
}
