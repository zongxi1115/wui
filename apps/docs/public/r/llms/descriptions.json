{
  "name": "descriptions",
  "type": "registry:ui",
  "title": "描述列表 Descriptions",
  "description": "以清晰的键值结构展示对象、记录与档案信息。",
  "import": "import { Descriptions, DescriptionsItem } from \"@/components/ui/descriptions\"",
  "exports": [
    "Descriptions",
    "DescriptionsItem"
  ],
  "typeExports": [
    "DescriptionsItemProps",
    "DescriptionsProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/descriptions",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/descriptions.json",
    "npmDependencies": [],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "title",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "描述列表上方显示的标题。"
    },
    {
      "name": "extra",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "显示在标题相对位置的操作内容。"
    },
    {
      "name": "columns",
      "type": "enum",
      "required": false,
      "control": "text",
      "defaultValue": "3",
      "description": "每行显示的描述项组数。"
    },
    {
      "name": "bordered",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否为标签和值绘制结构化边框。"
    },
    {
      "name": "layout",
      "type": "\"horizontal\" | \"vertical\"",
      "required": false,
      "control": "select",
      "options": [
        "horizontal",
        "vertical"
      ],
      "defaultValue": "horizontal",
      "description": "标签显示在值的旁边还是上方。"
    },
    {
      "name": "size",
      "type": "\"default\" | \"sm\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm"
      ],
      "defaultValue": "default",
      "description": "描述列表的垂直密度。"
    },
    {
      "name": "labelWidth",
      "type": "Width<string | number>",
      "required": false,
      "control": "text",
      "defaultValue": "7rem",
      "description": "横向布局中每个标签单元格的固定宽度。"
    }
  ],
  "events": "描述列表本身不产生业务事件。通过 `extra` 放置编辑、复制等轻量操作；字段值中的链接或按钮仍保留各自的原生事件。",
  "examples": [
    {
      "name": "descriptions-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/descriptions.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/descriptions",
  "sourceUrl": "https://ui.wzx.wang/r/descriptions.json"
}
