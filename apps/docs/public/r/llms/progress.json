{
  "name": "progress",
  "type": "registry:ui",
  "title": "进度条 Progress",
  "description": "细腻、克制并支持确定与不确定状态的进度指示器。",
  "import": "import { Progress, progressVariants } from \"@/components/ui/progress\"",
  "exports": [
    "Progress",
    "progressVariants"
  ],
  "typeExports": [
    "ProgressProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/progress",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/progress.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"linear\" | \"circular\"",
      "required": false,
      "control": "select",
      "options": [
        "linear",
        "circular"
      ],
      "defaultValue": "linear",
      "description": "进度指示器的布局形式。"
    },
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "线性进度条的厚度，或环形进度的直径。"
    },
    {
      "name": "color",
      "type": "\"destructive\" | \"success\" | \"warning\" | \"primary\" | \"blue\"",
      "required": false,
      "control": "select",
      "options": [
        "destructive",
        "success",
        "warning",
        "primary",
        "blue"
      ],
      "defaultValue": "primary",
      "description": "已完成部分使用的语义强调色。"
    },
    {
      "name": "showValue",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否在环形进度中显示当前百分比。"
    },
    {
      "name": "indicatorClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于已完成部分的额外 CSS 类名。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "进度条是只读状态组件，不提供交互事件。使用 `value` 更新完成度，并通过 `aria-label` 或 `getValueLabel` 提供可访问描述；\n如果页面上已经有“正在上传报告”等文字，不必重复读出同一段内容。",
  "examples": [
    {
      "name": "progress-demo",
      "title": "基础用法"
    },
    {
      "name": "progress-variants",
      "title": "颜色与环形进度"
    }
  ],
  "files": [
    "registry/ui/progress.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/progress",
  "sourceUrl": "https://ui.wzx.wang/r/progress.json"
}
