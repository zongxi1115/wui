{
  "name": "spotlight-card",
  "type": "registry:ui",
  "title": "聚光卡片 Spotlight Card",
  "description": "根据鼠标位置在内容表面显露一层局部光照。",
  "categories": [
    "pointer",
    "fancy"
  ],
  "import": "import { SpotlightCard } from \"@/components/ui/spotlight-card\"",
  "exports": [
    "SpotlightCard"
  ],
  "typeExports": [
    "SpotlightCardProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/spotlight-card",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/spotlight-card.json",
    "npmDependencies": [],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "显示在指针聚光效果上方的内容。"
    },
    {
      "name": "radius",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "220",
      "description": "聚光区域的半径，单位为像素。"
    },
    {
      "name": "color",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "color-mix(in oklab, var(--foreground) 16%, transparent)",
      "description": "聚光中心使用的 CSS 颜色。"
    },
    {
      "name": "spotlightClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于聚光图层的 CSS 类名。"
    }
  ],
  "usage": "通过 `radius` 调整影响范围，通过 `color` 使用与当前内容有关的低透明度颜色。聚光不能承载唯一的状态或操作提示；\n触摸输入下没有指针位置，内容仍必须完整可读。",
  "examples": [
    {
      "name": "spotlight-card-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/spotlight-card.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/spotlight-card",
  "sourceUrl": "https://ui.wzx.wang/r/spotlight-card.json"
}
