{
  "name": "select",
  "type": "registry:ui",
  "title": "下拉选择器 Select",
  "description": "用于在有限互斥选项中进行单项选择的下拉菜单组件，支持分组、尺寸密度、自定义渲染与完整的键盘导航无障碍支持。",
  "import": "import { Select, SelectContent, SelectGroup, SelectItem, SelectLabel, SelectScrollDownButton, SelectScrollUpButton, SelectSeparator, SelectTrigger, SelectValue, selectTriggerVariants } from \"@/components/ui/select\"",
  "exports": [
    "Select",
    "SelectContent",
    "SelectGroup",
    "SelectItem",
    "SelectLabel",
    "SelectScrollDownButton",
    "SelectScrollUpButton",
    "SelectSeparator",
    "SelectTrigger",
    "SelectValue",
    "selectTriggerVariants"
  ],
  "typeExports": [
    "SelectTriggerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/select",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/select.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "examples": [
    {
      "name": "select-demo",
      "title": "基础用法"
    },
    {
      "name": "select-controlled",
      "title": "受控模式与外部联动"
    },
    {
      "name": "select-sizes",
      "title": "尺寸规格"
    },
    {
      "name": "select-groups",
      "title": "分组与分隔线"
    },
    {
      "name": "select-custom-item",
      "title": "自定义选项渲染"
    },
    {
      "name": "select-disabled",
      "title": "禁用状态"
    },
    {
      "name": "select-form",
      "title": "表单与业务集成"
    }
  ],
  "files": [
    "registry/ui/select.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/select",
  "sourceUrl": "https://ui.wzx.wang/r/select.json"
}
