{
  "name": "select",
  "type": "registry:ui",
  "title": "下拉框 Select",
  "description": "支持分组、禁用项和键盘导航的选项选择器。",
  "import": "import { Select, SelectContent, SelectGroup, SelectItem, SelectLabel, SelectScrollDownButton, SelectScrollUpButton, SelectSeparator, SelectTrigger, SelectValue, selectTriggerVariants } from \"@/components/ui/select\"",
  "exports": [
    "Select",
    "SelectContent",
    "SelectGroup",
    "SelectItem",
    "SelectLabel",
    "SelectScrollDownButton",
    "SelectScrollUpButton",
    "SelectSeparator",
    "SelectTrigger",
    "SelectValue",
    "selectTriggerVariants"
  ],
  "typeExports": [
    "SelectTriggerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/select",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/select.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "events": "- `onValueChange(value)`：选中项变化后触发，参数是选项的 `value`。\n- `onOpenChange(open)`：浮层打开或关闭时触发。\n- `SelectItem` 支持 Radix 提供的选择、焦点和键盘事件。",
  "examples": [
    {
      "name": "select-demo",
      "title": "基础用法"
    },
    {
      "name": "select-groups",
      "title": "分组与分隔线"
    }
  ],
  "files": [
    "registry/ui/select.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/select",
  "sourceUrl": "https://ui.wzx.wang/r/select.json"
}
