{
  "name": "cascader",
  "type": "registry:ui",
  "title": "级联选择 Cascader",
  "description": "用于浏览和选择层级值的多列选择器。",
  "import": "import { Cascader } from \"@/components/ui/cascader\"",
  "exports": [
    "Cascader"
  ],
  "typeExports": [
    "CascaderOption",
    "CascaderProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/cascader",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/cascader.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils",
      "input"
    ]
  },
  "props": [
    {
      "name": "options",
      "type": "CascaderOption[]",
      "required": true,
      "control": "text",
      "description": "级联选项树。"
    },
    {
      "name": "value",
      "type": "string[]",
      "required": false,
      "control": "text",
      "description": "受控模式下当前选中的完整路径。"
    },
    {
      "name": "defaultValue",
      "type": "string[]",
      "required": false,
      "control": "text",
      "defaultValue": "[]",
      "description": "非受控模式下初始选中的完整路径。"
    },
    {
      "name": "onValueChange",
      "type": "((value: string[], options: CascaderOption[]) => void)",
      "required": false,
      "control": "text",
      "description": "选中路径变化时触发，并返回当前路径及对应选项。"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "请选择地区",
      "description": "未选择完整路径时显示的占位文本。"
    },
    {
      "name": "separator",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "defaultValue": "/",
      "description": "已选路径各层级之间显示的分隔符。"
    },
    {
      "name": "closeOnSelect",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "选择叶子节点后是否自动关闭选项面板。"
    },
    {
      "name": "panelLabel",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "级联选项",
      "description": "选项面板的无障碍名称。"
    },
    {
      "name": "contentClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于浮层面板的额外 CSS 类名。"
    },
    {
      "name": "renderValue",
      "type": "((options: CascaderOption[]) => ReactNode)",
      "required": false,
      "control": "text",
      "description": "自定义触发器中已选路径的渲染方式。"
    },
    {
      "name": "searchable",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "在面板顶部显示路径搜索框。@default false"
    },
    {
      "name": "searchPlaceholder",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "搜索选项",
      "description": "搜索框占位文本。@default \"搜索选项\""
    },
    {
      "name": "filterOption",
      "type": "((query: string, path: CascaderOption[]) => boolean)",
      "required": false,
      "control": "text",
      "description": "自定义路径匹配逻辑。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "events": "- `onValueChange(value, options)` 会在选择变化后触发，返回稳定的值路径和已解析的选项对象。\n- `onOpenChange` 由组件内部的触发器管理；默认选中叶子节点后关闭面板。\n- 触发器会透传标准按钮的聚焦和键盘激活事件。",
  "examples": [
    {
      "name": "cascader-demo",
      "title": "基础用法"
    },
    {
      "name": "cascader-search",
      "title": "模糊搜索"
    }
  ],
  "files": [
    "registry/ui/cascader.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/cascader",
  "sourceUrl": "https://ui.wzx.wang/r/cascader.json"
}
