{
  "name": "cascader",
  "type": "registry:ui",
  "title": "Cascader",
  "description": "用于浏览和选择层级值的多列选择器。",
  "import": "import { Cascader } from \"@/components/ui/cascader\"",
  "exports": [
    "Cascader"
  ],
  "typeExports": [
    "CascaderOption",
    "CascaderProps"
  ],
  "install": {
    "wui": "npx wui@latest add @wui/cascader",
    "shadcn": "npx shadcn@latest add http://localhost:3000/r/cascader.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "options",
      "type": "CascaderOption[]",
      "required": true,
      "control": "text",
      "description": "层级选项树。"
    },
    {
      "name": "value",
      "type": "string[]",
      "required": false,
      "control": "text",
      "description": "受控模式下的选中值路径。"
    },
    {
      "name": "defaultValue",
      "type": "string[]",
      "required": false,
      "control": "text",
      "defaultValue": "[]",
      "description": "非受控模式下的初始值路径。"
    },
    {
      "name": "onValueChange",
      "type": "((value: string[], options: CascaderOption[]) => void)",
      "required": false,
      "control": "text",
      "description": "当前路径发生变化时调用。"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "请选择地区",
      "description": "未选中完整路径时展示的占位文本。@default \"请选择地区\""
    },
    {
      "name": "separator",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "defaultValue": "/",
      "description": "选中标签之间的分隔符。@default \" / \""
    },
    {
      "name": "closeOnSelect",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "选中叶子节点后是否关闭面板。@default true"
    },
    {
      "name": "panelLabel",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "级联选项",
      "description": "选项面板的无障碍标签。@default \"级联选项\""
    },
    {
      "name": "contentClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于浮层面板的额外类名。"
    },
    {
      "name": "renderValue",
      "type": "((options: CascaderOption[]) => ReactNode)",
      "required": false,
      "control": "text",
      "description": "自定义触发器的选中值渲染。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean"
    }
  ],
  "events": "- `onValueChange(value, options)` 会在任一级发生变化后触发，并返回稳定值路径与已解析的选项对象。\n- `onOpenChange` 由组件内部的触发器管理；默认选中叶子节点后关闭面板。\n- 标准按钮的聚焦和键盘激活事件会透传给触发器。",
  "examples": [
    {
      "name": "cascader-demo",
      "title": "基础示例"
    }
  ],
  "files": [
    "registry/ui/cascader.tsx"
  ],
  "docsUrl": "http://localhost:3000/docs/components/cascader",
  "sourceUrl": "http://localhost:3000/r/cascader.json"
}
