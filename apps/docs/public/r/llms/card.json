{
  "name": "card",
  "type": "registry:ui",
  "title": "卡片 Card",
  "description": "将同一主题的内容、状态与操作组织在一个清晰的表面中。",
  "import": "import { Card, CardAction, CardContent, CardDescription, CardFooter, CardHeader, CardMedia, CardTitle } from \"@/components/ui/card\"",
  "exports": [
    "Card",
    "CardAction",
    "CardContent",
    "CardDescription",
    "CardFooter",
    "CardHeader",
    "CardMedia",
    "CardTitle"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/card",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/card.json",
    "npmDependencies": [],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"outline\" | \"elevated\"",
      "required": false,
      "control": "select",
      "options": [
        "outline",
        "elevated"
      ],
      "defaultValue": "elevated",
      "description": "卡片的表面样式。"
    },
    {
      "name": "interactive",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "卡片作为整体可操作时，是否显示按压反馈。"
    }
  ],
  "events": "卡片本身不产生业务事件，原生鼠标、键盘和焦点事件会继续透传。操作应放在 `CardAction` 或 `CardFooter` 内的 Button、\n链接等交互元素上，避免在一张卡片中嵌套相互冲突的点击区域。",
  "examples": [
    {
      "name": "card-demo",
      "title": "基础用法"
    },
    {
      "name": "card-composition",
      "title": "紧凑组合"
    }
  ],
  "files": [
    "registry/ui/card.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/card",
  "sourceUrl": "https://ui.wzx.wang/r/card.json"
}
