{
  "name": "ai-prompt-suggestions",
  "type": "registry:ui",
  "title": "AI 快捷提问建议 AI Prompt Suggestions",
  "description": "用于新会话空状态页面、输入框上方或追问引导的预设提问卡片与标签组。",
  "categories": [
    "ai"
  ],
  "import": "import { AiPromptSuggestionItem, AiPromptSuggestions, aiPromptSuggestionItemVariants, aiPromptSuggestionsVariants } from \"@/components/ui/ai-prompt-suggestions\"",
  "exports": [
    "AiPromptSuggestionItem",
    "AiPromptSuggestions",
    "aiPromptSuggestionItemVariants",
    "aiPromptSuggestionsVariants"
  ],
  "typeExports": [
    "AiPromptSuggestionItemProps",
    "AiPromptSuggestionsProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/ai-prompt-suggestions",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/ai-prompt-suggestions.json",
    "npmDependencies": [
      "class-variance-authority",
      "lucide-react"
    ],
    "registryDependencies": [
      "utils",
      "badge"
    ]
  },
  "props": [
    {
      "name": "layout",
      "type": "\"grid\" | \"scroll\" | \"chips\"",
      "required": false,
      "control": "select",
      "options": [
        "grid",
        "scroll",
        "chips"
      ],
      "defaultValue": "grid",
      "description": "快捷提示词组的排版布局方式（网格、横向滚动或胶囊标签）。"
    }
  ],
  "examples": [
    {
      "name": "ai-prompt-suggestions-demo",
      "title": "基础用法"
    },
    {
      "name": "ai-prompt-suggestions-chips",
      "title": "输入框上方的快捷追问胶囊"
    },
    {
      "name": "ai-prompt-suggestions-scroll",
      "title": "横向滑动的场景推荐列表"
    }
  ],
  "files": [
    "registry/ui/ai-prompt-suggestions.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/ai-prompt-suggestions",
  "sourceUrl": "https://ui.wzx.wang/r/ai-prompt-suggestions.json"
}
