{
  "name": "hover-marquee",
  "type": "registry:ui",
  "title": "浮入滚动目录 Hover Marquee",
  "description": "目录行浮入或聚焦后，显示无缝横向滚动的内容预览。",
  "categories": [
    "fancy",
    "motion"
  ],
  "import": "import { HoverMarquee } from \"@/components/ui/hover-marquee\"",
  "exports": [
    "HoverMarquee"
  ],
  "typeExports": [
    "HoverMarqueeProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/hover-marquee",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/hover-marquee.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils",
      "infinite-slider"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "列表行未激活时显示的内容。"
    },
    {
      "name": "marquee",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "浮入预览轨道中循环显示的内容。"
    },
    {
      "name": "speed",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "96",
      "description": "预览轨道移动速度，单位为每秒像素数。"
    },
    {
      "name": "gap",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "32",
      "description": "重复预览项之间的间距，单位为像素。"
    },
    {
      "name": "reverse",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否反转预览轨道的移动方向。"
    },
    {
      "name": "active",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否从组件外部强制打开预览。"
    },
    {
      "name": "marqueeClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于移动预览层的 CSS 类名。"
    }
  ],
  "usage": "将目录行放在 `children`，把需要重复滚动的内容放在 `marquee`。通过 `speed` 调整速度，并交替设置 `reverse`，可以形成左右错向的目录节奏。\n内容较长时应控制重复数量，避免用户焦点进入后需要等待很久才能看到完整信息。",
  "examples": [
    {
      "name": "hover-marquee-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/hover-marquee.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/hover-marquee",
  "sourceUrl": "https://ui.wzx.wang/r/hover-marquee.json"
}
