{
  "name": "in-view",
  "type": "registry:ui",
  "title": "进入视口 In View",
  "description": "当内容进入视口时播放可配置的入场动画。",
  "categories": [
    "motion"
  ],
  "import": "import { InView } from \"@/components/ui/in-view\"",
  "exports": [
    "InView"
  ],
  "typeExports": [
    "InViewProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/in-view",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/in-view.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": []
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "进入视口时需要播放动画的内容。"
    },
    {
      "name": "variants",
      "type": "Variants",
      "required": false,
      "control": "text",
      "defaultValue": "{\n  hidden: { opacity: 0, y: 16 },\n  visible: { opacity: 1, y: 0 },\n}",
      "description": "内容隐藏和显示时使用的动画变体。"
    },
    {
      "name": "transition",
      "type": "Transition",
      "required": false,
      "control": "text",
      "defaultValue": "{ duration: 0.45, ease: \"easeOut\" }",
      "description": "状态切换时使用的 Motion 过渡动画。"
    },
    {
      "name": "viewOptions",
      "type": "UseInViewOptions",
      "required": false,
      "control": "text",
      "description": "Intersection Observer 配置，例如 margin 和 amount。"
    },
    {
      "name": "once",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否只播放一次入场动画。"
    },
    {
      "name": "as",
      "type": "ElementType<any, keyof IntrinsicElements>",
      "required": false,
      "control": "text",
      "defaultValue": "div",
      "description": "组件实际渲染的 HTML 元素。"
    }
  ],
  "events": "组件透传底层元素的原生事件。需要获知可见状态时，可以通过自定义 `variants` 的 Motion 回调处理；`viewOptions` 支持 `margin` 和 `amount` 等观察参数。",
  "examples": [
    {
      "name": "in-view-demo",
      "title": "基础用法"
    },
    {
      "name": "in-view-image-reveal",
      "title": "图片遮罩揭示"
    }
  ],
  "files": [
    "registry/ui/in-view.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/in-view",
  "sourceUrl": "https://ui.wzx.wang/r/in-view.json"
}
