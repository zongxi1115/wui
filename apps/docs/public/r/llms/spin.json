{
  "name": "spin",
  "type": "registry:ui",
  "title": "加载中 Spin",
  "description": "用轻量、可降级的动态指示器表达等待状态。",
  "import": "import { Spin, spinIndicatorVariants } from \"@/components/ui/spin\"",
  "exports": [
    "Spin",
    "spinIndicatorVariants"
  ],
  "typeExports": [
    "SpinIndicatorProps",
    "SpinProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/spin",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/spin.json",
    "npmDependencies": [
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "spinning",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否显示加载状态。"
    },
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "加载指示器的尺寸。"
    },
    {
      "name": "label",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "显示在加载指示器旁边的无障碍提示文字。"
    },
    {
      "name": "indicator",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "替换默认的轨道式加载指示器。"
    },
    {
      "name": "delay",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0",
      "description": "显示加载指示器前等待的时间，避免快速操作出现闪烁。"
    },
    {
      "name": "fullscreen",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否覆盖整个视口，而不是在文档流中渲染。"
    }
  ],
  "events": "组件不产生业务事件，由 `spinning` 控制显示。`delay` 可以过滤瞬时请求造成的闪烁；用户开启“减少动态效果”后，\n旋转和弹性过渡会立即停用，但加载状态仍然会显示。",
  "examples": [
    {
      "name": "spin-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/spin.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/spin",
  "sourceUrl": "https://ui.wzx.wang/r/spin.json"
}
