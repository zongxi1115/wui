{
  "name": "bar-chart",
  "type": "registry:component",
  "title": "条形图 Bar Chart",
  "description": "从零基线比较分类数值，并支持分组序列与精确标签。",
  "categories": [
    "charts",
    "comparison"
  ],
  "import": "import { BarChart } from \"@/components/charts/bar-chart\"",
  "exports": [
    "BarChart"
  ],
  "typeExports": [
    "BarChartProps",
    "ChartDatum",
    "ChartLabelFormatter",
    "ChartReferenceLine",
    "ChartSeries",
    "ChartValueFormatter"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/bar-chart",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/bar-chart.json",
    "npmDependencies": [],
    "registryDependencies": [
      "chart-core"
    ]
  },
  "props": [
    {
      "name": "title",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "图表标题，用于说明正在比较的指标。"
    },
    {
      "name": "description",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "补充单位、时间范围或筛选条件的副标题。"
    },
    {
      "name": "actions",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "标题右侧的操作区，适合组合 Button、Select 或业务工具栏。"
    },
    {
      "name": "data",
      "type": "ChartDatum[]",
      "required": true,
      "control": "text",
      "description": "每行代表一个横轴分类的数据。"
    },
    {
      "name": "xKey",
      "type": "string",
      "required": true,
      "control": "text",
      "description": "用作横轴分类标签的数据字段。"
    },
    {
      "name": "series",
      "type": "ChartSeries[]",
      "required": true,
      "control": "text",
      "description": "要比较的数值序列。"
    },
    {
      "name": "height",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "280",
      "description": "图表绘图区高度，单位为像素。"
    },
    {
      "name": "domain",
      "type": "[number, number]",
      "required": false,
      "control": "text",
      "description": "手动指定纵轴最小值和最大值，范围应包含零。"
    },
    {
      "name": "showGrid",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否显示水平参考网格。"
    },
    {
      "name": "showValues",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否在柱形末端显示精确数值。"
    },
    {
      "name": "showLegend",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否在多序列时显示图例。"
    },
    {
      "name": "gap",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.2",
      "description": "柱形之间的间距比例。"
    },
    {
      "name": "radius",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "1.5",
      "description": "柱形圆角，单位为像素。"
    },
    {
      "name": "referenceLines",
      "type": "ChartReferenceLine[]",
      "required": false,
      "control": "text",
      "defaultValue": "[]",
      "description": "目标值、均值或阈值等纵轴参考线。"
    },
    {
      "name": "yAxisFormatter",
      "type": "((value: number) => ReactNode)",
      "required": false,
      "control": "text",
      "description": "自定义纵轴刻度的显示格式。"
    },
    {
      "name": "valueFormatter",
      "type": "ChartValueFormatter",
      "required": false,
      "control": "text",
      "defaultValue": "(value) => defaultValueFormatter(value)",
      "description": "自定义数值的显示格式。"
    },
    {
      "name": "labelFormatter",
      "type": "ChartLabelFormatter",
      "required": false,
      "control": "text",
      "defaultValue": "(value) => String(value)",
      "description": "自定义横轴标签和提示框标题的显示格式。"
    }
  ],
  "usage": "- 分类名称较短时使用默认纵向布局；分类很多时应减少数据或拆分视图，避免把横轴文字压缩到不可读。\n- `showValues` 适合少量柱形的精确比较，密集数据应保留提示框，避免标签互相碰撞。\n- `domain` 应包含零；只有比例变化、差值等明确语义的图表才应考虑其他尺度。",
  "events": "图表不产生业务事件，指针与键盘交互只用于读取数据。根元素会透传原生 `div` 属性，数据本身同时输出为仅辅助技术可见的表格。",
  "examples": [
    {
      "name": "bar-chart-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/charts/bar-chart.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/charts/bar-chart",
  "sourceUrl": "https://ui.wzx.wang/r/bar-chart.json"
}
