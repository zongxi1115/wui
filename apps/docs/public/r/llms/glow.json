{
  "name": "glow",
  "type": "registry:ui",
  "title": "渐变环绕发光 Glow",
  "description": "让多色渐变光线沿内容四周持续环绕，并提供单色发光变体。",
  "categories": [
    "fancy"
  ],
  "import": "import { Glow } from \"@/components/ui/glow\"",
  "exports": [
    "Glow"
  ],
  "typeExports": [
    "GlowProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/glow",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/glow.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "显示在发光边缘上方的内容。"
    },
    {
      "name": "variant",
      "type": "\"rainbow\" | \"solid\"",
      "required": false,
      "control": "select",
      "options": [
        "rainbow",
        "solid"
      ],
      "defaultValue": "rainbow",
      "description": "发光边缘的视觉样式。"
    },
    {
      "name": "color",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "oklch(0.7 0.2 260)",
      "description": "solid 样式使用的 CSS 颜色。"
    },
    {
      "name": "colors",
      "type": "string[]",
      "required": false,
      "control": "text",
      "defaultValue": "[\"#ff3d81\", \"#ffb800\", \"#34d399\", \"#38bdf8\", \"#8b5cf6\", \"#ff3d81\"]",
      "description": "沿彩虹边缘分布的颜色列表。"
    },
    {
      "name": "spread",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "18",
      "description": "光线超出边缘的距离，单位为像素。"
    },
    {
      "name": "borderWidth",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "1",
      "description": "发光边缘的宽度，单位为像素。"
    },
    {
      "name": "glowOpacity",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.7",
      "description": "发光效果的最大不透明度。"
    },
    {
      "name": "pulse",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否让 solid 样式缓慢呼吸。"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "4",
      "description": "一次发光动画循环的时长，单位为秒。"
    }
  ],
  "usage": "默认的 `rainbow` 变体通过 `colors`、`spread` 和 `duration` 调整环绕效果。使用 `variant=\"solid\"` 可以切换到单色呼吸光晕，\n并通过 `color`、`glowOpacity` 和 `pulse` 控制外观。用户开启“减少动态效果”时，两种变体都会停止动画。",
  "examples": [
    {
      "name": "glow-demo",
      "title": "基础用法"
    },
    {
      "name": "glow-card",
      "title": "重点推荐卡片"
    }
  ],
  "files": [
    "registry/ui/glow.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/glow",
  "sourceUrl": "https://ui.wzx.wang/r/glow.json"
}
