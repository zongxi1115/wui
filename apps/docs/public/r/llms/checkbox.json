{
  "name": "checkbox",
  "type": "registry:ui",
  "title": "多选框 Checkbox",
  "description": "支持选中、未选中与半选（不确定）状态的交互式多选控件，内置平滑勾选微动效与完整的键盘无障碍能力。",
  "import": "import { Checkbox, checkboxVariants } from \"@/components/ui/checkbox\"",
  "exports": [
    "Checkbox",
    "checkboxVariants"
  ],
  "typeExports": [
    "CheckboxProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/checkbox",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/checkbox.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "复选框的尺寸。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "examples": [
    {
      "name": "checkbox-demo",
      "title": "基础用法"
    },
    {
      "name": "checkbox-controlled",
      "title": "受控模式"
    },
    {
      "name": "checkbox-sizes",
      "title": "尺寸"
    },
    {
      "name": "checkbox-with-label",
      "title": "带标签与描述"
    },
    {
      "name": "checkbox-indeterminate",
      "title": "半选与全选联动 (Indeterminate)"
    },
    {
      "name": "checkbox-disabled",
      "title": "禁用状态"
    },
    {
      "name": "checkbox-card-group",
      "title": "多选卡片组"
    },
    {
      "name": "checkbox-form",
      "title": "表单校验与错误状态"
    }
  ],
  "files": [
    "registry/ui/checkbox.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/checkbox",
  "sourceUrl": "https://ui.wzx.wang/r/checkbox.json"
}
