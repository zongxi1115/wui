{
  "name": "checkbox",
  "type": "registry:ui",
  "title": "多选框 Checkbox",
  "description": "支持选中、未选中与不确定状态的多选控件。",
  "import": "import { Checkbox, checkboxVariants } from \"@/components/ui/checkbox\"",
  "exports": [
    "Checkbox",
    "checkboxVariants"
  ],
  "typeExports": [
    "CheckboxProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/checkbox",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/checkbox.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "复选框的尺寸。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "`onCheckedChange(checked)` 在状态变化后触发，值可能是 `true`、`false` 或 `\"indeterminate\"`。受控用法下，\n回调需要同步更新 `checked`，否则点击后界面不会保持新状态。其余键盘、焦点与表单属性会透传到底层 Radix Root。",
  "examples": [
    {
      "name": "checkbox-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/checkbox.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/checkbox",
  "sourceUrl": "https://ui.wzx.wang/r/checkbox.json"
}
