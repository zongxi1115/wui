{
  "name": "alert",
  "type": "registry:ui",
  "title": "警告提示 Alert",
  "description": "用于展示需要保留在页面中的状态、说明和操作建议。",
  "import": "import { Alert, alertVariants } from \"@/components/ui/alert\"",
  "exports": [
    "Alert",
    "alertVariants"
  ],
  "typeExports": [
    "AlertProps",
    "AlertVariant"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/alert",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/alert.json",
    "npmDependencies": [
      "lucide-react",
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"default\" | \"destructive\" | \"success\" | \"warning\" | \"info\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "destructive",
        "success",
        "warning",
        "info"
      ],
      "defaultValue": "default",
      "description": "提示的语义样式和默认图标。"
    },
    {
      "name": "size",
      "type": "\"compact\" | \"default\"",
      "required": false,
      "control": "select",
      "options": [
        "compact",
        "default"
      ],
      "defaultValue": "default",
      "description": "提示内容的密度尺寸。"
    },
    {
      "name": "title",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "说明文字上方显示的可选标题。"
    },
    {
      "name": "icon",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "自定义前置图标。传入 false 可隐藏图标。"
    },
    {
      "name": "action",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "显示在提示末尾的可选操作。"
    },
    {
      "name": "closable",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否显示关闭按钮。"
    },
    {
      "name": "visible",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "受控模式下提示是否显示。"
    },
    {
      "name": "defaultVisible",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "非受控模式下提示的初始显示状态。"
    },
    {
      "name": "onVisibleChange",
      "type": "((visible: boolean) => void)",
      "required": false,
      "control": "text",
      "description": "提示显示状态变化时触发。"
    }
  ],
  "examples": [
    {
      "name": "alert-demo",
      "title": "基础用法"
    },
    {
      "name": "alert-action",
      "title": "尾部操作"
    },
    {
      "name": "alert-dismissible",
      "title": "可关闭与受控显示"
    },
    {
      "name": "alert-compact",
      "title": "紧凑尺寸"
    }
  ],
  "files": [
    "registry/ui/alert.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/alert",
  "sourceUrl": "https://ui.wzx.wang/r/alert.json"
}
