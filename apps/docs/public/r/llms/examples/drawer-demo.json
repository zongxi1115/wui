{
  "name": "drawer-demo",
  "component": "drawer",
  "title": "详情预览面板",
  "code": "\"use client\"\n\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Drawer,\n  DrawerBody,\n  DrawerClose,\n  DrawerContent,\n  DrawerDescription,\n  DrawerFooter,\n  DrawerHeader,\n  DrawerTitle,\n  DrawerTrigger,\n} from \"@/components/ui/drawer\"\nimport { Descriptions, DescriptionsItem } from \"@/components/ui/descriptions\"\n\nexport default function DrawerDemo() {\n  return (\n    <Drawer>\n      <DrawerTrigger asChild>\n        <Button motion>查看发布详情</Button>\n      </DrawerTrigger>\n      <DrawerContent size=\"default\">\n        <DrawerHeader>\n          <DrawerTitle>版本 2.8.0</DrawerTitle>\n          <DrawerDescription>检查变更后再发布到生产环境。</DrawerDescription>\n        </DrawerHeader>\n        <DrawerBody>\n          <Descriptions columns={1} size=\"sm\">\n            <DescriptionsItem label=\"分支\">release/2.8</DescriptionsItem>\n            <DescriptionsItem label=\"提交\">7f2ac91</DescriptionsItem>\n            <DescriptionsItem label=\"负责人\">林澈</DescriptionsItem>\n            <DescriptionsItem label=\"变更\">\n              12 个文件 · +428 / -96\n            </DescriptionsItem>\n          </Descriptions>\n          <div className=\"border-primary mt-6 border-l-2 pl-3\">\n            <p className=\"text-sm font-medium\">部署检查已通过</p>\n            <p className=\"text-muted-foreground mt-1 text-sm leading-6\">\n              类型检查、依赖审计与预览环境均已完成。\n            </p>\n          </div>\n        </DrawerBody>\n        <DrawerFooter>\n          <DrawerClose asChild>\n            <Button variant=\"outline\">取消</Button>\n          </DrawerClose>\n          <Button>确认发布</Button>\n        </DrawerFooter>\n      </DrawerContent>\n    </Drawer>\n  )\n}\n"
}
