{
  "name": "breadcrumb-with-icons",
  "component": "breadcrumb",
  "title": "搭配图标指示",
  "code": "\"use client\"\n\nimport { FolderIcon, HomeIcon, SettingsIcon } from \"lucide-react\"\n\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from \"@/components/ui/breadcrumb\"\n\nexport default function BreadcrumbWithIcons() {\n  return (\n    <Breadcrumb>\n      <BreadcrumbList>\n        <BreadcrumbItem>\n          <BreadcrumbLink href=\"#\" className=\"flex items-center gap-1.5\">\n            <HomeIcon className=\"size-4\" />\n            <span>首页</span>\n          </BreadcrumbLink>\n        </BreadcrumbItem>\n        <BreadcrumbSeparator />\n        <BreadcrumbItem>\n          <BreadcrumbLink href=\"#\" className=\"flex items-center gap-1.5\">\n            <FolderIcon className=\"size-4\" />\n            <span>工程管理</span>\n          </BreadcrumbLink>\n        </BreadcrumbItem>\n        <BreadcrumbSeparator />\n        <BreadcrumbItem>\n          <BreadcrumbLink href=\"#\" className=\"flex items-center gap-1.5\">\n            <FolderIcon className=\"size-4\" />\n            <span>WUI 组件库</span>\n          </BreadcrumbLink>\n        </BreadcrumbItem>\n        <BreadcrumbSeparator />\n        <BreadcrumbItem>\n          <BreadcrumbPage className=\"flex items-center gap-1.5\">\n            <SettingsIcon className=\"size-4\" />\n            <span>安全策略</span>\n          </BreadcrumbPage>\n        </BreadcrumbItem>\n      </BreadcrumbList>\n    </Breadcrumb>\n  )\n}\n"
}
