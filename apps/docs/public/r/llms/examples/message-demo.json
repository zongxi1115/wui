{
  "name": "message-demo",
  "component": "message",
  "title": "基础用法",
  "code": "\"use client\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { MessageProvider, useMessage } from \"@/components/ui/message\"\n\nexport default function MessageDemo() {\n  return (\n    <MessageProvider>\n      <MessageTypeButtons />\n    </MessageProvider>\n  )\n}\n\nfunction MessageTypeButtons() {\n  const message = useMessage()\n\n  return (\n    <div className=\"flex w-full max-w-xl flex-wrap justify-center gap-2.5\">\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => message.info(\"新功能已灰度发布，可在设置中开启。\")}\n      >\n        信息\n      </Button>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => message.success(\"配置已保存\")}\n      >\n        成功\n      </Button>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => message.warning(\"网络连接较慢，正在尝试重连...\")}\n      >\n        警告\n      </Button>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => message.error(\"数据加载失败，请检查网络权限。\")}\n      >\n        错误\n      </Button>\n    </div>\n  )\n}\n"
}
