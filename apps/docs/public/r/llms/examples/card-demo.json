{
  "name": "card-demo",
  "component": "card",
  "title": "基础用法",
  "code": "import { ArrowUpRightIcon } from \"lucide-react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport {\n  Card,\n  CardAction,\n  CardContent,\n  CardDescription,\n  CardFooter,\n  CardHeader,\n  CardTitle,\n} from \"@/components/ui/card\"\nimport { Progress } from \"@/components/ui/progress\"\n\nconst facts = [\n  { label: \"负责人\", value: \"林澈\" },\n  { label: \"截止日期\", value: \"8 月 28 日\" },\n]\n\nexport default function CardDemo() {\n  return (\n    <Card className=\"w-full max-w-md\">\n      <CardHeader>\n        <CardTitle>体验升级计划</CardTitle>\n        <CardDescription>统一关键业务流程的视觉反馈与交互微动效。</CardDescription>\n        <CardAction>\n          <Button variant=\"ghost\" size=\"icon\" aria-label=\"查看项目详情\">\n            <ArrowUpRightIcon className=\"size-4\" />\n          </Button>\n        </CardAction>\n      </CardHeader>\n      <CardContent className=\"flex flex-col gap-5\">\n        <div className=\"flex flex-col gap-2.5\">\n          <div className=\"flex items-baseline justify-between\">\n            <span className=\"text-muted-foreground text-xs\">整体完成进度</span>\n            <span className=\"text-xl font-semibold tabular-nums tracking-tight\">\n              72\n              <span className=\"text-muted-foreground ml-0.5 text-sm font-normal\">\n                %\n              </span>\n            </span>\n          </div>\n          <Progress value={72} aria-label=\"完成进度\" />\n        </div>\n        <dl className=\"border-border/60 grid grid-cols-2 divide-x border-y py-3\">\n          {facts.map((fact) => (\n            <div key={fact.label} className=\"first:pr-4 last:pl-4\">\n              <dt className=\"text-muted-foreground text-xs\">{fact.label}</dt>\n              <dd className=\"mt-1.5 text-sm font-medium tracking-[-0.01em]\">\n                {fact.value}\n              </dd>\n            </div>\n          ))}\n        </dl>\n      </CardContent>\n      <CardFooter className=\"justify-between pt-0.5\">\n        <span className=\"text-muted-foreground text-xs\">\n          最近更新于 2 小时前\n        </span>\n        <Button size=\"sm\">进入工作台</Button>\n      </CardFooter>\n    </Card>\n  )\n}\n"
}
