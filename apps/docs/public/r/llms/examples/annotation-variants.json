{
  "name": "annotation-variants",
  "component": "annotation",
  "title": "荧光笔变体",
  "code": "import { AnnotationHighlight } from \"@/components/ui/annotation\"\n\nexport default function AnnotationVariantsDemo() {\n  return (\n    <div className=\"w-full max-w-xl divide-y border-y\">\n      <div className=\"py-5\">\n        <p className=\"text-muted-foreground text-xs\">variant=&quot;smooth&quot;</p>\n        <p className=\"mt-2 text-base leading-8\">\n          平整的荧光笔适合文档与说明：\n          <AnnotationHighlight>默认琥珀色</AnnotationHighlight>、\n          <AnnotationHighlight\n            color=\"color-mix(in oklch, var(--success) 25%, transparent)\"\n            delay={0.2}\n          >\n            成功绿\n          </AnnotationHighlight>\n          ，或者\n          <AnnotationHighlight\n            color=\"color-mix(in oklch, var(--info) 25%, transparent)\"\n            delay={0.4}\n          >\n            信息蓝\n          </AnnotationHighlight>\n          。\n        </p>\n      </div>\n      <div className=\"py-5\">\n        <p className=\"text-muted-foreground text-xs\">variant=&quot;rough&quot;</p>\n        <p className=\"mt-2 text-base leading-8\">\n          双层笔触带来\n          <AnnotationHighlight variant=\"rough\">手写批注的质感</AnnotationHighlight>\n          ，适合\n          <AnnotationHighlight\n            variant=\"rough\"\n            color=\"color-mix(in oklch, var(--destructive) 22%, transparent)\"\n            delay={0.3}\n          >\n            设计评审\n          </AnnotationHighlight>\n          与编辑修订。\n        </p>\n      </div>\n    </div>\n  )\n}\n"
}
