{
  "name": "combobox-sizes",
  "component": "combobox",
  "title": "尺寸规格",
  "code": "\"use client\"\n\nimport * as React from \"react\"\n\nimport { Combobox } from \"@/components/ui/combobox\"\n\nconst options = [\n  { value: \"github\", label: \"GitHub\" },\n  { value: \"gitlab\", label: \"GitLab\" },\n  { value: \"bitbucket\", label: \"Bitbucket\" },\n]\n\nexport default function ComboboxSizes() {\n  return (\n    <div className=\"flex w-full max-w-sm flex-col gap-5\">\n      <div className=\"flex flex-col gap-1.5\">\n        <span className=\"text-xs font-medium text-muted-foreground\">紧凑尺寸 (sm - 32px)</span>\n        <Combobox\n          size=\"sm\"\n          options={options}\n          defaultValue=\"github\"\n          placeholder=\"选择平台\"\n          searchPlaceholder=\"搜索平台…\"\n        />\n      </div>\n\n      <div className=\"flex flex-col gap-1.5\">\n        <span className=\"text-xs font-medium text-muted-foreground\">默认尺寸 (default - 40px)</span>\n        <Combobox\n          size=\"default\"\n          options={options}\n          defaultValue=\"github\"\n          placeholder=\"选择平台\"\n          searchPlaceholder=\"搜索平台…\"\n        />\n      </div>\n\n      <div className=\"flex flex-col gap-1.5\">\n        <span className=\"text-xs font-medium text-muted-foreground\">大尺寸 (lg - 48px)</span>\n        <Combobox\n          size=\"lg\"\n          options={options}\n          defaultValue=\"github\"\n          placeholder=\"选择平台\"\n          searchPlaceholder=\"搜索平台…\"\n        />\n      </div>\n    </div>\n  )\n}\n"
}
