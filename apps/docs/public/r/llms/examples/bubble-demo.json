{
  "name": "bubble-demo",
  "component": "bubble",
  "title": "基础用法",
  "code": "\"use client\"\n\nimport { CopyIcon, MoreHorizontalIcon, RotateCcwIcon } from \"lucide-react\"\n\nimport {\n  Avatar,\n  AvatarBadge,\n  AvatarFallback,\n} from \"@/components/ui/avatar\"\nimport {\n  Bubble,\n  BubbleActions,\n  BubbleAvatar,\n  BubbleBody,\n  BubbleContent,\n  BubbleFooter,\n  BubbleHeader,\n} from \"@/components/ui/bubble\"\nimport { Button } from \"@/components/ui/button\"\n\nexport default function BubbleDemo() {\n  return (\n    <div className=\"mx-auto flex w-full max-w-xl flex-col gap-6\">\n      <Bubble>\n        <BubbleAvatar>\n          <Avatar size=\"sm\">\n            <AvatarFallback>林</AvatarFallback>\n            <AvatarBadge status=\"online\" size=\"sm\" />\n          </Avatar>\n        </BubbleAvatar>\n        <BubbleBody>\n          <BubbleHeader>\n            <span className=\"font-medium text-foreground\">林晚</span>\n            <time>10:24</time>\n          </BubbleHeader>\n          <BubbleContent>\n            我已经整理好评审意见，交互部分还需要确认一次键盘操作。\n          </BubbleContent>\n          <BubbleFooter>\n            已编辑\n            <BubbleActions className=\"opacity-0 transition-opacity duration-200 group-hover/bubble:opacity-100 focus-within:opacity-100\">\n              <Button\n                variant=\"ghost\"\n                size=\"icon\"\n                className=\"size-7\"\n                aria-label=\"复制消息\"\n              >\n                <CopyIcon />\n              </Button>\n              <Button\n                variant=\"ghost\"\n                size=\"icon\"\n                className=\"size-7\"\n                aria-label=\"更多操作\"\n              >\n                <MoreHorizontalIcon />\n              </Button>\n            </BubbleActions>\n          </BubbleFooter>\n        </BubbleBody>\n      </Bubble>\n\n      <Bubble side=\"end\">\n        <BubbleAvatar>\n          <Avatar size=\"sm\">\n            <AvatarFallback className=\"bg-primary text-primary-foreground\">\n              我\n            </AvatarFallback>\n          </Avatar>\n        </BubbleAvatar>\n        <BubbleBody>\n          <BubbleHeader>\n            <span className=\"font-medium text-foreground\">你</span>\n            <time>10:26</time>\n          </BubbleHeader>\n          <BubbleContent variant=\"primary\">\n            没问题，我会补齐焦点顺序和 Escape 关闭行为。\n          </BubbleContent>\n          <BubbleFooter>\n            已送达\n            <BubbleActions className=\"opacity-0 transition-opacity duration-200 group-hover/bubble:opacity-100 focus-within:opacity-100\">\n              <Button\n                variant=\"ghost\"\n                size=\"icon\"\n                className=\"size-7\"\n                aria-label=\"重新发送\"\n              >\n                <RotateCcwIcon />\n              </Button>\n            </BubbleActions>\n          </BubbleFooter>\n        </BubbleBody>\n      </Bubble>\n    </div>\n  )\n}\n"
}
