{
  "name": "glow-badge",
  "component": "glow",
  "title": "状态指示与公告胶囊（Pills）",
  "code": "import { Glow } from \"@/components/ui/glow\"\n\nexport default function GlowBadge() {\n  return (\n    <div className=\"flex flex-wrap items-center justify-center gap-6\">\n      <Glow spread={10} duration={5} glowOpacity={0.6} className=\"rounded-full\">\n        <span className=\"bg-background flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-medium\">\n          全新 AI 工作台预览版上线\n        </span>\n      </Glow>\n\n      <Glow\n        variant=\"solid\"\n        color=\"var(--success)\"\n        spread={12}\n        glowOpacity={0.45}\n        duration={2.4}\n        className=\"rounded-full\"\n      >\n        <span className=\"bg-background flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-medium\">\n          <span className=\"bg-success size-1.5 rounded-full\" />\n          所有服务运行正常\n        </span>\n      </Glow>\n\n      <Glow\n        variant=\"solid\"\n        color=\"var(--warning)\"\n        spread={12}\n        glowOpacity={0.45}\n        duration={2.4}\n        className=\"rounded-full\"\n      >\n        <span className=\"bg-background flex items-center gap-2 rounded-full px-3.5 py-1.5 text-xs font-medium\">\n          <span className=\"bg-warning size-1.5 rounded-full\" />\n          今晚 23:00 例行维护\n        </span>\n      </Glow>\n    </div>\n  )\n}\n"
}
