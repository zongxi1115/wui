  "title": "自定义分隔符",
  "code": "\"use client\"\n\nimport { ArrowRightIcon, SlashIcon } from \"lucide-react\"\n\nimport {\n  Breadcrumb,\n  BreadcrumbItem,\n  BreadcrumbLink,\n  BreadcrumbList,\n  BreadcrumbPage,\n  BreadcrumbSeparator,\n} from \"@/components/ui/breadcrumb\"\n\nexport default function BreadcrumbCustomSeparator() {\n  return (\n    <div className=\"flex flex-col gap-6\">\n      {/* 斜线分隔符 */}\n      <div className=\"space-y-1.5\">\n        <p className=\"text-xs font-medium text-muted-foreground\">斜线分隔符</p>\n        <Breadcrumb>\n          <BreadcrumbList>\n            <BreadcrumbItem>\n              <BreadcrumbLink href=\"#\">工作台</BreadcrumbLink>\n            </BreadcrumbItem>\n            <BreadcrumbSeparator>\n              <SlashIcon />\n            </BreadcrumbSeparator>\n            <BreadcrumbItem>\n              <BreadcrumbLink href=\"#\">数据大屏</BreadcrumbLink>\n            </BreadcrumbItem>\n            <BreadcrumbSeparator>\n              <SlashIcon />\n            </BreadcrumbSeparator>\n            <BreadcrumbItem>\n              <BreadcrumbPage>实时流量分析</BreadcrumbPage>\n            </BreadcrumbItem>\n          </BreadcrumbList>\n        </Breadcrumb>\n      </div>\n\n      {/* 箭头分隔符 */}\n      <div className=\"space-y-1.5\">\n        <p className=\"text-xs font-medium text-muted-foreground\">箭头推进分隔符</p>\n        <Breadcrumb>\n          <BreadcrumbList>\n            <BreadcrumbItem>\n              <BreadcrumbLink href=\"#\">订单中心</BreadcrumbLink>\n            </BreadcrumbItem>\n            <BreadcrumbSeparator>\n              <ArrowRightIcon />\n            </BreadcrumbSeparator>\n            <BreadcrumbItem>\n              <BreadcrumbLink href=\"#\">售后工单</BreadcrumbLink>\n            </BreadcrumbItem>\n            <BreadcrumbSeparator>\n              <ArrowRightIcon />\n            </BreadcrumbSeparator>\n            <BreadcrumbItem>\n              <BreadcrumbPage>工单 #20260819-0941</BreadcrumbPage>\n            </BreadcrumbItem>\n          </BreadcrumbList>\n        </Breadcrumb>\n      </div>\n\n      {/* 圆点字符分隔符 */}\n      <div className=\"space-y-1.5\">\n        <p className=\"text-xs font-medium text-muted-foreground\">字符点分隔符</p>\n        <Breadcrumb>\n          <BreadcrumbList>\n            <BreadcrumbItem>\n              <BreadcrumbLink href=\"#\">开发者中心</BreadcrumbLink>\n            </BreadcrumbItem>\n            <BreadcrumbSeparator>•</BreadcrumbSeparator>\n            <BreadcrumbItem>\n              <BreadcrumbLink href=\"#\">开放 API</BreadcrumbLink>\n            </BreadcrumbItem>\n            <BreadcrumbSeparator>•</BreadcrumbSeparator>\n            <BreadcrumbItem>\n              <BreadcrumbPage>Webhooks 订阅</BreadcrumbPage>\n            </BreadcrumbItem>\n          </BreadcrumbList>\n        </Breadcrumb>\n      </div>\n    </div>\n  )\n}\n"
}
