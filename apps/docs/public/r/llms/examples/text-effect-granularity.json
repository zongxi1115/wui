{
  "name": "text-effect-granularity",
  "component": "text-effect",
  "title": "拆分颗粒度比较",
  "code": "\"use client\"\n\nimport * as React from \"react\"\nimport { RotateCcwIcon } from \"lucide-react\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { TextEffect } from \"@/components/ui/text-effect\"\n\nexport default function TextEffectGranularity() {\n  const [key, setKey] = React.useState(0)\n\n  return (\n    <div className=\"w-full max-w-xl\">\n      <div key={key} className=\"divide-y border-y\">\n        <div className=\"grid gap-2 py-5 sm:grid-cols-[7rem_1fr]\">\n          <code className=\"text-muted-foreground text-xs\">per=&quot;char&quot;</code>\n          <TextEffect\n            as=\"h4\"\n            per=\"char\"\n            preset=\"fade-in-blur\"\n            className=\"text-lg font-semibold tracking-tight\"\n          >\n            Design System 2.0 正式发布\n          </TextEffect>\n        </div>\n        <div className=\"grid gap-2 py-5 sm:grid-cols-[7rem_1fr]\">\n          <code className=\"text-muted-foreground text-xs\">per=&quot;word&quot;</code>\n          <TextEffect per=\"word\" preset=\"slide\" className=\"text-sm leading-6\">\n            Accessible components, tuned motion and 中文排版优化, all in one kit.\n          </TextEffect>\n        </div>\n        <div className=\"grid gap-2 py-5 sm:grid-cols-[7rem_1fr]\">\n          <code className=\"text-muted-foreground text-xs\">per=&quot;line&quot;</code>\n          <TextEffect\n            as=\"div\"\n            per=\"line\"\n            preset=\"blur-sm\"\n            speedReveal={0.8}\n            className=\"text-muted-foreground gap-1 text-sm\"\n          >\n            {`统一的设计语言与类型系统\\n内置 WAI-ARIA 键盘交互规范\\n克制、可降级的界面动效`}\n          </TextEffect>\n        </div>\n      </div>\n      <div className=\"mt-4 flex justify-end\">\n        <Button variant=\"ghost\" size=\"sm\" onClick={() => setKey((k) => k + 1)}>\n          <RotateCcwIcon />\n          全部重播\n        </Button>\n      </div>\n    </div>\n  )\n}\n"
}
