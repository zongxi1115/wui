{
  "name": "message-positions",
  "component": "message",
  "title": "弹出方位 (Positions)",
  "code": "\"use client\"\n\nimport { Button } from \"@/components/ui/button\"\nimport { MessagePosition, MessageProvider, useMessage } from \"@/components/ui/message\"\n\nexport default function MessagePositions() {\n  return (\n    <MessageProvider>\n      <MessagePositionButtons />\n    </MessageProvider>\n  )\n}\n\nfunction MessagePositionButtons() {\n  const message = useMessage()\n\n  const trigger = (position: MessagePosition, label: string) => {\n    message.open({\n      position,\n      description: `${label}弹出的消息（${position}）`,\n      variant: \"info\",\n    })\n  }\n\n  return (\n    <div className=\"grid grid-cols-2 sm:grid-cols-3 gap-2.5 max-w-lg w-full\">\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => trigger(\"top-left\", \"左上方\")}\n      >\n        左上\n      </Button>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => trigger(\"top\", \"正上方\")}\n      >\n        顶部（默认）\n      </Button>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => trigger(\"top-right\", \"右上方\")}\n      >\n        右上\n      </Button>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => trigger(\"bottom-left\", \"左下方\")}\n      >\n        左下\n      </Button>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => trigger(\"bottom\", \"正下方\")}\n      >\n        底部\n      </Button>\n      <Button\n        variant=\"outline\"\n        size=\"sm\"\n        onClick={() => trigger(\"bottom-right\", \"右下方\")}\n      >\n        右下\n      </Button>\n    </div>\n  )\n}\n"
}
