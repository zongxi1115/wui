{
  "name": "table",
  "type": "registry:ui",
  "title": "表格 Table",
  "description": "用原生表格语义组织和比较结构化数据。",
  "import": "import { Table, TableBody, TableCaption, TableCell, TableFooter, TableHead, TableHeader, TableRow, tableVariants } from \"@/components/ui/table\"",
  "exports": [
    "Table",
    "TableBody",
    "TableCaption",
    "TableCell",
    "TableFooter",
    "TableHead",
    "TableHeader",
    "TableRow",
    "tableVariants"
  ],
  "typeExports": [
    "TableCellProps",
    "TableHeadProps",
    "TableProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/table",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/table.json",
    "npmDependencies": [
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "containerClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于横向滚动容器的额外 CSS 类名。"
    },
    {
      "name": "density",
      "type": "\"compact\" | \"default\"",
      "required": false,
      "control": "select",
      "options": [
        "compact",
        "default"
      ],
      "defaultValue": "default",
      "description": "控制单元格内边距和行高。"
    },
    {
      "name": "striped",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否为表格主体的交替行添加浅色背景。"
    },
    {
      "name": "stickyHeader",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "表格容器滚动时是否保持表头可见。"
    }
  ],
  "events": "所有原生表格事件都会透传，例如在 `TableRow` 上使用 `onClick`、`onPointerEnter` 或键盘事件。组件不内置选择逻辑；\n需要展示选中状态时，在行上设置 `data-state=\"selected\"`，并由业务状态负责更新。可点击行仍应提供清晰的键盘操作方式。",
  "examples": [
    {
      "name": "table-demo",
      "title": "基础用法"
    },
    {
      "name": "table-compact",
      "title": "紧凑密度与斑马纹"
    },
    {
      "name": "table-advanced",
      "title": "高级数据表格"
    }
  ],
  "files": [
    "registry/ui/table.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/table",
  "sourceUrl": "https://ui.wzx.wang/r/table.json"
}
