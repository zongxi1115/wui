{
  "name": "time-picker",
  "type": "registry:ui",
  "title": "时间选择器 Time Picker",
  "description": "用小时、分钟与时制分栏快速设定时间。",
  "import": "import { TimePicker, formatTime, parseTime } from \"@/components/ui/time-picker\"",
  "exports": [
    "TimePicker",
    "formatTime",
    "parseTime"
  ],
  "typeExports": [
    "TimePickerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/time-picker",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/time-picker.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "value",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "当前选中的时间，格式为 24 小时制 HH:mm。"
    },
    {
      "name": "defaultValue",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "非受控模式下初始选中的时间。"
    },
    {
      "name": "onValueChange",
      "type": "((value: string) => void)",
      "required": false,
      "control": "text",
      "description": "时间变化时触发，并返回 24 小时制 HH:mm 值。"
    },
    {
      "name": "hourCycle",
      "type": "enum",
      "required": false,
      "control": "text",
      "defaultValue": "24",
      "description": "时间显示使用 12 小时制还是 24 小时制。"
    },
    {
      "name": "minuteStep",
      "type": "enum",
      "required": false,
      "control": "text",
      "defaultValue": "5",
      "description": "分钟选择的间隔。"
    },
    {
      "name": "placeholder",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "选择时间",
      "description": "没有选中时间时显示的占位文本。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "events": "点击“确定”后触发 `onValueChange(value)` 并关闭弹层。受控模式由调用方更新 `value`；非受控模式使用 `defaultValue`。\n用户只修改了弹层中的临时值但没有点击确认时，不会提交新值。",
  "examples": [
    {
      "name": "time-picker-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/time-picker.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/time-picker",
  "sourceUrl": "https://ui.wzx.wang/r/time-picker.json"
}
