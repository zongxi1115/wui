{
  "name": "input-number",
  "type": "registry:ui",
  "title": "数字输入框 InputNumber",
  "description": "专为数值录入设计的精度步进输入组件，支持上下范围约束、浮点数精度保持、键盘加速微调与表单校验。",
  "import": "import { InputNumber, inputNumberVariants } from \"@/components/ui/input-number\"",
  "exports": [
    "InputNumber",
    "inputNumberVariants"
  ],
  "typeExports": [
    "InputNumberProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/input-number",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/input-number.json",
    "npmDependencies": [
      "lucide-react"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "value",
      "type": "number | null",
      "required": false,
      "control": "text",
      "description": "当前数值；传入后组件进入受控模式。"
    },
    {
      "name": "defaultValue",
      "type": "number",
      "required": false,
      "control": "number",
      "description": "非受控模式下的初始数值。"
    },
    {
      "name": "onValueChange",
      "type": "((value: number | null) => void)",
      "required": false,
      "control": "text",
      "description": "数值变化时触发，清空输入时返回 `null`。"
    },
    {
      "name": "min",
      "type": "number",
      "required": false,
      "control": "number",
      "description": "允许输入的最小值。"
    },
    {
      "name": "max",
      "type": "number",
      "required": false,
      "control": "number",
      "description": "允许输入的最大值。"
    },
    {
      "name": "step",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "1",
      "description": "点击按钮或按方向键时的步进值。"
    },
    {
      "name": "prefix",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "前缀插槽（如货币符号 ¥、$）。"
    },
    {
      "name": "suffix",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "后缀插槽（如单位 kg、%、GiB）。"
    },
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "尺寸密度。@default \"default\""
    },
    {
      "name": "wrapperClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "输入框外层容器样式。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    }
  ],
  "examples": [
    {
      "name": "input-number-demo",
      "title": "基础用法"
    },
    {
      "name": "input-number-controlled",
      "title": "受控模式与计算联动"
    },
    {
      "name": "input-number-sizes",
      "title": "尺寸规格"
    },
    {
      "name": "input-number-advanced",
      "title": "浮点精度与自定义步长"
    },
    {
      "name": "input-number-disabled",
      "title": "禁用与只读状态"
    },
    {
      "name": "input-number-form",
      "title": "资源配额与表单应用"
    }
  ],
  "files": [
    "registry/ui/input-number.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/input-number",
  "sourceUrl": "https://ui.wzx.wang/r/input-number.json"
}
