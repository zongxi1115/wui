{
  "name": "message",
  "type": "registry:ui",
  "title": "消息 Message",
  "description": "用于在操作后提供短暂、轻量的全局反馈。",
  "import": "import { MessageProvider, useMessage } from \"@/components/ui/message\"",
  "exports": [
    "MessageProvider",
    "useMessage"
  ],
  "typeExports": [
    "MessageApi",
    "MessageMotionConfig",
    "MessageOptions",
    "MessagePosition",
    "MessageProviderProps",
    "MessageVariant"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/message",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/message.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "@animateicons/react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "position",
      "type": "\"top\" | \"bottom\" | \"top-left\" | \"top-right\" | \"bottom-left\" | \"bottom-right\"",
      "required": false,
      "control": "select",
      "options": [
        "top",
        "bottom",
        "top-left",
        "top-right",
        "bottom-left",
        "bottom-right"
      ],
      "defaultValue": "top",
      "description": "消息默认显示在屏幕上的位置。"
    },
    {
      "name": "duration",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "3000",
      "description": "消息默认显示时长，单位为毫秒。"
    },
    {
      "name": "maxCount",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "5",
      "description": "同时显示的消息数量上限。超出后优先移除较早的消息。"
    },
    {
      "name": "offset",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "20",
      "description": "消息与视口边缘的距离，单位为像素。"
    },
    {
      "name": "gap",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "10",
      "description": "堆叠消息之间的间距，单位为像素。"
    },
    {
      "name": "stacked",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否将消息重叠堆叠显示，而不是显示为纵向列表。"
    },
    {
      "name": "maxVisibleMessages",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "3",
      "description": "堆叠队列中同时显示的最大层数。"
    },
    {
      "name": "scaleFactor",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.05",
      "description": "每增加一层时应用的缩放幅度。"
    },
    {
      "name": "expandOnHover",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "鼠标悬停或键盘聚焦时是否展开消息堆。"
    },
    {
      "name": "dragToDismiss",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否允许通过水平拖动移除消息。"
    },
    {
      "name": "dragThreshold",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "72",
      "description": "触发拖动移除所需的水平距离，单位为像素。"
    },
    {
      "name": "motion",
      "type": "Partial<MessageMotionConfig>",
      "required": false,
      "control": "text",
      "defaultValue": "{}",
      "description": "所有消息共用的动效配置。"
    }
  ],
  "examples": [
    {
      "name": "message-demo",
      "title": "基础用法"
    },
    {
      "name": "message-motion",
      "title": "自定义透明度与动效"
    },
    {
      "name": "message-stack",
      "title": "堆叠与拖动移除"
    }
  ],
  "files": [
    "registry/ui/message.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/message",
  "sourceUrl": "https://ui.wzx.wang/r/message.json"
}
