{
  "name": "confirm-dialog",
  "type": "registry:component",
  "title": "确认对话框 Confirm Dialog",
  "description": "由 Dialog 和 Button 组合而成的开箱即用确认对话框。",
  "import": "import { ConfirmDialog } from \"@/components/confirm-dialog\"",
  "exports": [
    "ConfirmDialog"
  ],
  "typeExports": [
    "ConfirmDialogProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/confirm-dialog",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/confirm-dialog.json",
    "npmDependencies": [],
    "registryDependencies": [
      "dialog",
      "button"
    ]
  },
  "props": [
    {
      "name": "trigger",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "打开对话框的触发元素。使用 asChild 时会直接渲染为该元素。"
    },
    {
      "name": "title",
      "type": "string",
      "required": true,
      "control": "text",
      "description": "对话框顶部显示的标题。"
    },
    {
      "name": "description",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "标题下方显示的补充说明。"
    },
    {
      "name": "confirmLabel",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "Confirm",
      "description": "确认按钮的文字。"
    },
    {
      "name": "cancelLabel",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "Cancel",
      "description": "取消按钮的文字。"
    },
    {
      "name": "variant",
      "type": "\"default\" | \"destructive\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "destructive"
      ],
      "defaultValue": "default",
      "description": "确认按钮的视觉样式。"
    },
    {
      "name": "onConfirm",
      "type": "(() => void)",
      "required": false,
      "control": "text",
      "description": "用户点击确认按钮时触发。"
    }
  ],
  "examples": [
    {
      "name": "confirm-dialog-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/components/confirm-dialog.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/confirm-dialog",
  "sourceUrl": "https://ui.wzx.wang/r/confirm-dialog.json"
}
