{
  "name": "skeleton",
  "type": "registry:ui",
  "title": "骨架屏 Skeleton",
  "description": "在内容加载期间维持页面结构，降低布局跳动与等待的不确定感。",
  "import": "import { Skeleton, SkeletonText, skeletonVariants } from \"@/components/ui/skeleton\"",
  "exports": [
    "Skeleton",
    "SkeletonText",
    "skeletonVariants"
  ],
  "typeExports": [
    "SkeletonProps",
    "SkeletonTextProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/skeleton",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/skeleton.json",
    "npmDependencies": [
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "shape",
      "type": "\"default\" | \"circle\" | \"text\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "circle",
        "text"
      ],
      "defaultValue": "default",
      "description": "Corner treatment for the placeholder."
    },
    {
      "name": "animation",
      "type": "\"none\" | \"pulse\"",
      "required": false,
      "control": "select",
      "options": [
        "none",
        "pulse"
      ],
      "defaultValue": "pulse",
      "description": "Loading animation."
    }
  ],
  "usage": "`Skeleton` 在内容尚未到达时保留其大致形状与空间，适合首屏资料、列表、图片和文字区域。骨架布局应尽量接近真实内容，但不需要复刻每个细节；操作完成后的反馈应使用 Progress 或 Message，而不是 Skeleton。",
  "extended": "### 内容布局\r\n\r\n\r\n\r\n用真实页面使用的 Grid 或 Flex 布局组合多个 Skeleton，可以在数据到达前稳定保留版面。设置 `animation=\"none\"` 可关闭脉冲效果；系统启用“减少动态效果”时，动画也会自动停用。",
  "events": "骨架屏是非交互元素，不触发事件，并默认对辅助技术隐藏。加载区域应在父容器设置 `aria-busy=\"true\"`，并通过 `aria-label` 或邻近状态文本说明正在加载的内容。",
  "examples": [
    {
      "name": "skeleton-demo",
      "title": "基础示例"
    },
    {
      "name": "skeleton-layout",
      "title": "内容布局"
    }
  ],
  "files": [
    "registry/ui/skeleton.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/skeleton",
  "sourceUrl": "https://ui.wzx.wang/r/skeleton.json"
}
