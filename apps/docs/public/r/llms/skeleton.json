{
  "name": "skeleton",
  "type": "registry:ui",
  "title": "骨架屏 Skeleton",
  "description": "在内容加载期间维持页面结构，降低布局跳动与等待的不确定感。",
  "import": "import { Skeleton, SkeletonText, skeletonVariants } from \"@/components/ui/skeleton\"",
  "exports": [
    "Skeleton",
    "SkeletonText",
    "skeletonVariants"
  ],
  "typeExports": [
    "SkeletonProps",
    "SkeletonTextProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/skeleton",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/skeleton.json",
    "npmDependencies": [
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "shape",
      "type": "\"default\" | \"circle\" | \"text\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "circle",
        "text"
      ],
      "defaultValue": "default",
      "description": "占位骨架的圆角样式。"
    },
    {
      "name": "animation",
      "type": "\"none\" | \"pulse\"",
      "required": false,
      "control": "select",
      "options": [
        "none",
        "pulse"
      ],
      "defaultValue": "pulse",
      "description": "加载时使用的动画样式。"
    }
  ],
  "events": "骨架屏是非交互元素，不触发事件，并默认对辅助技术隐藏。加载区域应在父容器设置 `aria-busy=\"true\"`，\n并通过 `aria-label` 或邻近状态文本说明正在加载的内容；不要把每一条灰色占位块都暴露给读屏器。",
  "examples": [
    {
      "name": "skeleton-demo",
      "title": "基础用法"
    },
    {
      "name": "skeleton-layout",
      "title": "内容布局"
    }
  ],
  "files": [
    "registry/ui/skeleton.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/skeleton",
  "sourceUrl": "https://ui.wzx.wang/r/skeleton.json"
}
