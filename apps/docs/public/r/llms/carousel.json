{
  "name": "carousel",
  "type": "registry:ui",
  "title": "轮播 Carousel",
  "description": "基于原生 CSS 滚动与 scroll-snap 物理吸附机制构建的高性能轮播组件，支持横向/纵向滑动、循环滚动与多列响应式排版。",
  "import": "import { Carousel, CarouselContent, CarouselItem, CarouselNext, CarouselPrevious } from \"@/components/ui/carousel\"",
  "exports": [
    "Carousel",
    "CarouselContent",
    "CarouselItem",
    "CarouselNext",
    "CarouselPrevious"
  ],
  "typeExports": [
    "CarouselProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/carousel",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/carousel.json",
    "npmDependencies": [
      "lucide-react"
    ],
    "registryDependencies": [
      "utils",
      "button"
    ]
  },
  "props": [
    {
      "name": "orientation",
      "type": "\"horizontal\" | \"vertical\"",
      "required": false,
      "control": "select",
      "options": [
        "horizontal",
        "vertical"
      ],
      "defaultValue": "horizontal",
      "description": "轮播内容的滚动方向。@default \"horizontal\""
    },
    {
      "name": "loop",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "到达末端后是否允许循环到另一端。@default false"
    },
    {
      "name": "defaultIndex",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0",
      "description": "初次渲染时显示的项目索引。@default 0"
    },
    {
      "name": "onIndexChange",
      "type": "((index: number) => void)",
      "required": false,
      "control": "text",
      "description": "当前项目变化时触发。"
    }
  ],
  "examples": [
    {
      "name": "carousel-demo",
      "title": "基础用法"
    },
    {
      "name": "carousel-cards",
      "title": "多卡片响应式轮播 (Multi-card)"
    },
    {
      "name": "carousel-vertical",
      "title": "垂直方向轮播 (Vertical)"
    }
  ],
  "files": [
    "registry/ui/carousel.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/carousel",
  "sourceUrl": "https://ui.wzx.wang/r/carousel.json"
}
