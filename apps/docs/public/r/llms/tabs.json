{
  "name": "tabs",
  "type": "registry:ui",
  "title": "标签栏 Tabs",
  "description": "使用共享布局动效平滑切换内容分区。",
  "import": "import { Tabs, TabsContent, TabsList, TabsTrigger, tabsListVariants } from \"@/components/ui/tabs\"",
  "exports": [
    "Tabs",
    "TabsContent",
    "TabsList",
    "TabsTrigger",
    "tabsListVariants"
  ],
  "typeExports": [
    "TabsListProps",
    "TabsProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/tabs",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/tabs.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "events": "- `onValueChange(value)`：当前标签变化后触发，参数是 `TabsTrigger` 的 `value`。\n- 键盘方向键、Home、End 与焦点管理由 Radix 处理。",
  "examples": [
    {
      "name": "tabs-demo",
      "title": "基础用法"
    },
    {
      "name": "tabs-underline",
      "title": "下划线样式"
    }
  ],
  "files": [
    "registry/ui/tabs.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/tabs",
  "sourceUrl": "https://ui.wzx.wang/r/tabs.json"
}
