{
  "name": "dialog",
  "type": "registry:ui",
  "title": "对话框 Dialog",
  "description": "基于 Radix UI 构建、覆盖在主窗口之上的浮层窗口。",
  "import": "import { Dialog, DialogClose, DialogContent, DialogDescription, DialogFooter, DialogHeader, DialogOverlay, DialogPortal, DialogTitle, DialogTrigger } from \"@/components/ui/dialog\"",
  "exports": [
    "Dialog",
    "DialogClose",
    "DialogContent",
    "DialogDescription",
    "DialogFooter",
    "DialogHeader",
    "DialogOverlay",
    "DialogPortal",
    "DialogTitle",
    "DialogTrigger"
  ],
  "typeExports": [
    "DialogProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/dialog",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/dialog.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"inline\" | \"modal\"",
      "required": false,
      "control": "select",
      "options": [
        "inline",
        "modal"
      ],
      "defaultValue": "modal",
      "description": "显示为居中的模态对话框，或在文档流中从触发元素原地展开。"
    }
  ],
  "examples": [
    {
      "name": "dialog-demo",
      "title": "基础用法"
    },
    {
      "name": "dialog-layout",
      "title": "原地布局变换（非模态）"
    }
  ],
  "files": [
    "registry/ui/dialog.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/dialog",
  "sourceUrl": "https://ui.wzx.wang/r/dialog.json"
}
