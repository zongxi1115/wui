{
  "name": "ai-stream",
  "type": "registry:ui",
  "title": "AI 流式文本 AI Stream",
  "description": "可用于普通回答与思考过程的通用流式文本动效。",
  "categories": [
    "ai"
  ],
  "import": "import { AiStream, AiStreamDeltas } from \"@/components/ui/ai-stream\"",
  "exports": [
    "AiStream",
    "AiStreamDeltas"
  ],
  "typeExports": [
    "AiStreamDeltasProps",
    "AiStreamProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/ai-stream",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/ai-stream.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "string",
      "required": true,
      "control": "text",
      "description": "已经接收到的完整文本内容。"
    },
    {
      "name": "isStreaming",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否仍在接收后续文本。"
    },
    {
      "name": "featherLength",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "18",
      "description": "实时渐隐效果覆盖的末尾字符数量。"
    }
  ],
  "examples": [
    {
      "name": "ai-stream-demo",
      "title": "基础用法"
    },
    {
      "name": "ai-stream-deltas",
      "title": "Delta 分段模式"
    }
  ],
  "files": [
    "registry/ui/ai-stream.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/ai-stream",
  "sourceUrl": "https://ui.wzx.wang/r/ai-stream.json"
}
