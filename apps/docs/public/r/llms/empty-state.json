{
  "name": "empty-state",
  "type": "registry:ui",
  "title": "空状态 Empty State",
  "description": "在没有数据或结果时解释现状并引导下一步。",
  "import": "import { EmptyState, EmptyStateActions, EmptyStateDescription, EmptyStateHint, EmptyStateIcon, EmptyStateIllustration, EmptyStateMedia, EmptyStateTitle, emptyStateClassicIllustrations, emptyStateColorIllustrations, emptyStateIllustrations, emptyStateVariants } from \"@/components/ui/empty-state\"",
  "exports": [
    "EmptyState",
    "EmptyStateActions",
    "EmptyStateDescription",
    "EmptyStateHint",
    "EmptyStateIcon",
    "EmptyStateIllustration",
    "EmptyStateMedia",
    "EmptyStateTitle",
    "emptyStateClassicIllustrations",
    "emptyStateColorIllustrations",
    "emptyStateIllustrations",
    "emptyStateVariants"
  ],
  "typeExports": [
    "EmptyStateClassicIllustration",
    "EmptyStateColorIllustration",
    "EmptyStateIllustrationProps",
    "EmptyStateIllustrationVariant",
    "EmptyStateProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/empty-state",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/empty-state.json",
    "npmDependencies": [
      "class-variance-authority"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "size",
      "type": "\"default\" | \"sm\" | \"lg\"",
      "required": false,
      "control": "select",
      "options": [
        "default",
        "sm",
        "lg"
      ],
      "defaultValue": "default",
      "description": "Vertical density preset."
    }
  ],
  "usage": "`EmptyState` 用于首次使用、筛选无结果和内容被清空后的页面区域。标题应说明发生了什么，描述解释原因或价值，主操作只保留最合理的下一步；加载中应使用 Skeleton，错误反馈应使用 Message。",
  "extended": "使用 `size` 控制纵向留白；简单语义图标使用 `EmptyStateIcon`，复杂插画使用 `EmptyStateMedia` 与 `EmptyStateIllustration`。`EmptyStateHint` 用于放置快捷键、拖放提示等低优先级信息。",
  "events": "容器本身不产生业务事件。操作由 `EmptyStateActions` 中组合的 Button 或链接承担，原生容器事件仍会透传。",
  "examples": [
    {
      "name": "empty-state-demo",
      "title": "基础示例"
    },
    {
      "name": "empty-state-illustrations",
      "title": "内置插画"
    }
  ],
