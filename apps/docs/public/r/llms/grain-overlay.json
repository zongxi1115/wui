      "name": "opacity",
      "type": "number",
      "required": false,
      "defaultValue": "0.16",
      "description": "颗粒图层的不透明度。"
    },
    {
      "name": "frequency",
      "type": "number",
      "required": false,
      "defaultValue": "0.72",
      "description": "基础湍流频率。"
    },
    {
      "name": "octaves",
      "type": "number",
      "required": false,
      "defaultValue": "3",
      "description": "分形噪声的叠加层数。"
    },
    {
      "name": "seed",
      "type": "number",
      "required": false,
      "defaultValue": "8",
      "description": "用于生成可复现噪声的随机种子。"
    },
    {
      "name": "blendMode",
      "type": "\"color\" | \"inherit\" | \"initial\" | \"-moz-initial\" | \"revert\" | \"revert-layer\" | \"unset\" | \"color-burn\" | \"color-dodge\" | \"darken\" | \"difference\" | \"exclusion\" | \"hard-light\" | \"hue\" | \"lighten\" | \"luminosity\" | \"multiply\" | \"normal\" | \"overlay\" | \"saturation\" | \"screen\" | \"soft-light\" | \"plus-darker\" | \"plus-lighter\"",
      "required": false,
      "options": [
        "color",
        "inherit",
        "initial",
        "-moz-initial",
        "revert",
        "revert-layer",
        "unset",
        "color-burn",
        "color-dodge",
