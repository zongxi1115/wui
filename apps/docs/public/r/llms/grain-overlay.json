        "exclusion",
        "hard-light",
        "hue",
        "lighten",
        "luminosity",
        "multiply",
        "normal",
        "overlay",
        "saturation",
        "screen",
        "soft-light",
        "plus-darker",
        "plus-lighter"
      ],
      "defaultValue": "soft-light",
      "description": "遮罩图层使用的 CSS 混合模式。"
    },
    {
      "name": "animated",
      "type": "boolean",
      "required": false,
      "defaultValue": "false",
      "description": "是否让颗粒像胶片放映一样抖动，父元素需要裁剪溢出内容。"
    },
