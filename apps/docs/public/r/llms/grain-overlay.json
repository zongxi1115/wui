{
  "name": "grain-overlay",
  "type": "registry:ui",
  "title": "颗粒纹理遮罩 Grain Overlay",
  "description": "利用 SVG 分形噪点（feTurbulence）滤镜为卡片、大图与渐变背景增添电影级胶片质感与材质温度的纹理组件。",
  "categories": [
    "background",
    "fancy"
  ],
  "import": "import { GrainOverlay } from \"@/components/ui/grain-overlay\"",
  "exports": [
    "GrainOverlay"
  ],
  "typeExports": [
    "GrainOverlayProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/grain-overlay",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/grain-overlay.json",
    "npmDependencies": [],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
