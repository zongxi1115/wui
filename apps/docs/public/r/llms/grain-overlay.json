{
  "name": "grain-overlay",
  "type": "registry:ui",
  "title": "颗粒遮罩 Grain Overlay",
  "description": "用可缩放 SVG 噪声为任意表面增加克制的胶片颗粒质感。",
  "categories": [
    "background",
    "fancy"
  ],
  "import": "import { GrainOverlay } from \"@/components/ui/grain-overlay\"",
  "exports": [
    "GrainOverlay"
  ],
  "typeExports": [
    "GrainOverlayProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/grain-overlay",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/grain-overlay.json",
    "npmDependencies": [],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "opacity",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.16",
      "description": "颗粒图层的不透明度。"
    },
    {
      "name": "frequency",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.72",
      "description": "基础湍流频率。"
    },
    {
      "name": "octaves",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "3",
      "description": "分形噪声的叠加层数。"
    },
    {
      "name": "seed",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "8",
      "description": "用于生成可复现噪声的随机种子。"
    },
    {
      "name": "blendMode",
      "type": "\"inherit\" | \"color\" | \"initial\" | \"-moz-initial\" | \"revert\" | \"revert-layer\" | \"unset\" | \"color-burn\" | \"color-dodge\" | \"darken\" | \"difference\" | \"exclusion\" | \"hard-light\" | \"hue\" | \"lighten\" | \"luminosity\" | \"multiply\" | \"normal\" | \"overlay\" | \"saturation\" | \"screen\" | \"soft-light\" | \"plus-darker\" | \"plus-lighter\"",
      "required": false,
      "control": "select",
      "options": [
        "inherit",
        "color",
        "initial",
        "-moz-initial",
        "revert",
        "revert-layer",
        "unset",
        "color-burn",
        "color-dodge",
        "darken",
        "difference",
        "exclusion",
        "hard-light",
        "hue",
        "lighten",
        "luminosity",
        "multiply",
        "normal",
        "overlay",
        "saturation",
        "screen",
        "soft-light",
        "plus-darker",
        "plus-lighter"
      ],
      "defaultValue": "soft-light",
      "description": "遮罩图层使用的 CSS 混合模式。"
    }
  ],
  "usage": "建议从 `opacity={0.08}` 到 `0.18` 的范围开始，根据底色选择 `soft-light`、`overlay` 或 `multiply`。颗粒应作为统一材质语言使用，\n不要只给一张普通卡片单独添加；大面积铺设前应在低端设备上确认 SVG 滤镜成本。",
  "examples": [
    {
      "name": "grain-overlay-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/grain-overlay.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/grain-overlay",
  "sourceUrl": "https://ui.wzx.wang/r/grain-overlay.json"
}
