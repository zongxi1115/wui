{
  "name": "image-trail",
  "type": "registry:ui",
  "title": "图像轨迹 Image Trail",
  "description": "鼠标移动时沿路径依次甩出短暂的图片或视觉片段。",
  "categories": [
    "pointer",
    "motion",
    "fancy"
  ],
  "import": "import { ImageTrail } from \"@/components/ui/image-trail\"",
  "exports": [
    "ImageTrail"
  ],
  "typeExports": [
    "ImageTrailProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/image-trail",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/image-trail.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "items",
      "type": "ReactNode[]",
      "required": true,
      "control": "text",
      "description": "指针移动时依次循环显示的视觉内容。"
    },
    {
      "name": "children",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "交互区域内始终显示的静态内容。"
    },
    {
      "name": "distance",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "72",
      "description": "新增一项轨迹内容前指针需要移动的距离，单位为像素。"
    },
    {
      "name": "lifetime",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "720",
      "description": "每项轨迹内容的显示时长，单位为毫秒。"
    },
    {
      "name": "maxItems",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "8",
      "description": "同时渲染的轨迹内容数量上限。"
    },
    {
      "name": "itemClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于每个定位轨迹项的 CSS 类名。"
    }
  ],
  "usage": "`distance` 越小轨迹越密，`lifetime` 越长重叠越多。轨迹项目应使用固定尺寸，并避免包含可交互元素；真正的信息和操作放在静态 `children` 中。\n触摸输入和用户的“减少动态效果”偏好不会生成轨迹。",
  "examples": [
    {
      "name": "image-trail-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/image-trail.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/image-trail",
  "sourceUrl": "https://ui.wzx.wang/r/image-trail.json"
}
