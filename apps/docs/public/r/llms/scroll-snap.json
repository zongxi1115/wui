{
  "name": "scroll-snap",
  "type": "registry:ui",
  "title": "滚动吸附 Scroll Snap",
  "description": "用原生 CSS Scroll Snap 构建整屏或横向吸附章节。",
  "categories": [
    "scroll"
  ],
  "import": "import { ScrollSnap, ScrollSnapItem } from \"@/components/ui/scroll-snap\"",
  "exports": [
    "ScrollSnap",
    "ScrollSnapItem"
  ],
  "typeExports": [
    "ScrollSnapItemProps",
    "ScrollSnapProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/scroll-snap",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/scroll-snap.json",
    "npmDependencies": [],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "axis",
      "type": "\"x\" | \"y\"",
      "required": false,
      "control": "select",
      "options": [
        "x",
        "y"
      ],
      "defaultValue": "y",
      "description": "滚动吸附的方向。"
    },
    {
      "name": "strictness",
      "type": "\"mandatory\" | \"proximity\"",
      "required": false,
      "control": "select",
      "options": [
        "mandatory",
        "proximity"
      ],
      "defaultValue": "mandatory",
      "description": "浏览器是否必须最终停在某个吸附点上。"
    },
    {
      "name": "hideScrollbar",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否隐藏原生滚动条，同时保留滚动能力。"
    }
  ],
  "usage": "整屏叙事可以使用纵向 `mandatory`，自由浏览的卡片轨道更适合横向 `proximity`。`stop` 会阻止快速手势跳过某一节，\n只应给必须经过的关键步骤使用。即使隐藏滚动条，也应通过截断内容、章节计数或邻近元素提示当前区域仍可滚动。",
  "examples": [
    {
      "name": "scroll-snap-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/scroll-snap.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/scroll-snap",
  "sourceUrl": "https://ui.wzx.wang/r/scroll-snap.json"
}
