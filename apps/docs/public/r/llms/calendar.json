{
  "name": "calendar",
  "type": "registry:ui",
  "title": "日历 Calendar",
  "description": "用可访问的月视图浏览并选择单个日期。",
  "import": "import { Calendar, CalendarPanel, sameDay, startOfMonth } from \"@/components/ui/calendar\"",
  "exports": [
    "Calendar",
    "CalendarPanel",
    "sameDay",
    "startOfMonth"
  ],
  "typeExports": [
    "CalendarEvent",
    "CalendarEventTone",
    "CalendarPanelProps",
    "CalendarProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/calendar",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/calendar.json",
    "npmDependencies": [
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "value",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "当前选中的日期。"
    },
    {
      "name": "defaultValue",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "非受控模式下初始选中的日期。"
    },
    {
      "name": "onValueChange",
      "type": "((date: Date) => void)",
      "required": false,
      "control": "text",
      "description": "用户选择日期时触发。"
    },
    {
      "name": "month",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "当前显示的月份。"
    },
    {
      "name": "defaultMonth",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "非受控模式下初始显示的月份。"
    },
    {
      "name": "onMonthChange",
      "type": "((month: Date) => void)",
      "required": false,
      "control": "text",
      "description": "用户切换月份导致显示月份变化时触发。"
    },
    {
      "name": "min",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "允许选择的最早日期。"
    },
    {
      "name": "max",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "允许选择的最晚日期。"
    },
    {
      "name": "disabled",
      "type": "((date: Date) => boolean)",
      "required": false,
      "control": "text",
      "description": "用于判断日期是否禁用的匹配函数。"
    },
    {
      "name": "showOutsideDays",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否显示当前月份前后相邻月份的日期。"
    },
    {
      "name": "locale",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "zh-CN",
      "description": "格式化月份标题时使用的地区设置。"
    }
  ],
  "events": "`onValueChange(date)` 在选择日期后触发；`onMonthChange(month)` 在切换月份时触发。组件同时支持受控和非受控模式。\n需要从服务端加载月份数据时，应在 `onMonthChange` 中请求并处理加载状态；Calendar 不会自动请求日程数据。\n\r\n选中背景会在日期之间移动；当天的小圆点在被选中时展开为完整背景。鼠标经过日期网格时，悬停层会跟随当前格子，\n用户开启“减少动态效果”后会直接呈现最终状态。",
  "examples": [
    {
      "name": "calendar-demo",
      "title": "基础用法"
    },
    {
      "name": "calendar-panel",
      "title": "大型日历面板"
    }
  ],
  "files": [
    "registry/ui/calendar.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/calendar",
  "sourceUrl": "https://ui.wzx.wang/r/calendar.json"
}
