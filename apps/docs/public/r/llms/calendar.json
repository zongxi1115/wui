{
  "name": "calendar",
  "type": "registry:ui",
  "title": "日历 Calendar",
  "description": "用可访问的月视图浏览并选择单个日期。",
  "import": "import { Calendar, sameDay, startOfMonth } from \"@/components/ui/calendar\"",
  "exports": [
    "Calendar",
    "sameDay",
    "startOfMonth"
  ],
  "typeExports": [
    "CalendarProps"
  ],
  "install": {
    "wui": "npx wui@latest add @wui/calendar",
    "shadcn": "npx shadcn@latest add http://localhost:3000/r/calendar.json",
    "npmDependencies": [
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "value",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "Selected date."
    },
    {
      "name": "defaultValue",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "Initially selected date in uncontrolled mode."
    },
    {
      "name": "onValueChange",
      "type": "((date: Date) => void)",
      "required": false,
      "control": "text",
      "description": "Called when a day is selected."
    },
    {
      "name": "month",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "Visible month."
    },
    {
      "name": "defaultMonth",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "Initial visible month in uncontrolled mode."
    },
    {
      "name": "onMonthChange",
      "type": "((month: Date) => void)",
      "required": false,
      "control": "text",
      "description": "Called when month navigation changes the visible month."
    },
    {
      "name": "min",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "Earliest selectable day."
    },
    {
      "name": "max",
      "type": "Date",
      "required": false,
      "control": "text",
      "description": "Latest selectable day."
    },
    {
      "name": "disabled",
      "type": "((date: Date) => boolean)",
      "required": false,
      "control": "text",
      "description": "Custom disabled-day matcher."
    },
    {
      "name": "showOutsideDays",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "Show days from adjacent months."
    },
    {
      "name": "locale",
      "type": "string",
      "required": false,
      "control": "text",
      "defaultValue": "zh-CN",
      "description": "Locale used to format the month heading."
    }
  ],
  "usage": "`Calendar` 适合需要直接呈现月份上下文的日期选择、排期和预约场景。它内置相邻月份日期、今天标记、禁用区间和方向键导航；如果界面空间有限，应使用由它组合而成的 DatePicker。",
  "extended": "通过 `min`、`max` 或 `disabled(date)` 限制可选范围；将 `showOutsideDays` 设为 `false` 可隐藏相邻月份日期。业务应在组件外呈现预约余量或日程摘要，避免让每个日期格承载过多信息。",
  "events": "`onValueChange(date)` 在选择日期后触发；`onMonthChange(month)` 在切换月份时触发。组件同时支持受控与非受控模式。\n\n选中背景会在日期之间弹性移动；当天的小圆点在被选中时原地展开为完整背景。鼠标经过日期网格时，轻量悬停层会在格子之间平滑跟随，并在系统开启“减少动态效果”时自动降级。",
  "examples": [
    {
      "name": "calendar-demo",
      "title": "基础示例"
    }
  ],
  "files": [
    "registry/ui/calendar.tsx"
  ],
  "docsUrl": "http://localhost:3000/docs/components/calendar",
  "sourceUrl": "http://localhost:3000/r/calendar.json"
}
