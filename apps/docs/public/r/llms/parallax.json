{
  "name": "parallax",
  "type": "registry:ui",
  "title": "视差 Parallax",
  "description": "让内容层在经过视口时以不同速度平移或缩放。",
  "categories": [
    "scroll",
    "motion"
  ],
  "import": "import { Parallax } from \"@/components/ui/parallax\"",
  "exports": [
    "Parallax"
  ],
  "typeExports": [
    "ParallaxProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/parallax",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/parallax.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "随包装容器经过视口而产生位移的内容。"
    },
    {
      "name": "axis",
      "type": "\"x\" | \"y\"",
      "required": false,
      "control": "select",
      "options": [
        "x",
        "y"
      ],
      "defaultValue": "y",
      "description": "内容移动的方向。"
    },
    {
      "name": "distance",
      "type": "[number, number]",
      "required": false,
      "control": "text",
      "defaultValue": "[-48, 48]",
      "description": "从滚动开始到结束的位移范围，单位为像素。"
    },
    {
      "name": "scale",
      "type": "[number, number]",
      "required": false,
      "control": "text",
      "description": "可选的缩放范围，适合在画框中展示图片时使用。"
    },
    {
      "name": "container",
      "type": "RefObject<HTMLElement | null>",
      "required": false,
      "control": "text",
      "description": "要监听的滚动容器；未设置时监听页面。"
    },
    {
      "name": "offset",
      "type": "ScrollOffset",
      "required": false,
      "control": "text",
      "defaultValue": "[\"start end\", \"end start\"]",
      "description": "包装容器使用的 Motion 滚动偏移范围。"
    }
  ],
  "usage": "图片内层视差应把 `Parallax` 放在 `overflow-hidden` 的固定画框内，并给内容预留超出画框的尺寸。建议从 `[-32, 32]`\n到 `[-72, 72]` 的小范围开始；移动距离过大会让内容显得脱离布局或被裁切。用户开启“减少动态效果”后内容保持静止。",
  "examples": [
    {
      "name": "parallax-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/parallax.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/parallax",
  "sourceUrl": "https://ui.wzx.wang/r/parallax.json"
}
