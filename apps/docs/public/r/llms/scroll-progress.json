{
  "name": "scroll-progress",
  "type": "registry:ui",
  "title": "滚动进度 Scroll Progress",
  "description": "用顶部进度条或环形指示器显示页面、容器或区块的阅读进度。",
  "categories": [
    "scroll",
    "motion"
  ],
  "import": "import { ScrollProgress } from \"@/components/ui/scroll-progress\"",
  "exports": [
    "ScrollProgress"
  ],
  "typeExports": [
    "ScrollProgressProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/scroll-progress",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/scroll-progress.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "variant",
      "type": "\"circle\" | \"bar\"",
      "required": false,
      "control": "select",
      "options": [
        "circle",
        "bar"
      ],
      "defaultValue": "bar",
      "description": "进度指示器的视觉形式。"
    },
    {
      "name": "position",
      "type": "\"inline\" | \"top\" | \"bottom\"",
      "required": false,
      "control": "select",
      "options": [
        "inline",
        "top",
        "bottom"
      ],
      "defaultValue": "top",
      "description": "固定进度条所在的边缘。使用 inline 可让它保留在正常文档流中。"
    },
    {
      "name": "container",
      "type": "RefObject<HTMLElement | null>",
      "required": false,
      "control": "text",
      "description": "要监听的滚动容器；未设置时监听页面。"
    },
    {
      "name": "target",
      "type": "RefObject<HTMLElement | null>",
      "required": false,
      "control": "text",
      "description": "用于计算进度的目标元素。目标元素经过视口时会推动进度变化。"
    },
    {
      "name": "offset",
      "type": "ScrollOffset",
      "required": false,
      "control": "text",
      "description": "设置 target 后使用的 Motion 滚动偏移范围。"
    },
    {
      "name": "size",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "44",
      "description": "环形指示器的直径，单位为像素。"
    },
    {
      "name": "strokeWidth",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "3",
      "description": "环形指示器的描边宽度，单位为像素。"
    },
    {
      "name": "smooth",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否使用弹簧平滑处理突然的滚动进度变化。"
    },
    {
      "name": "trackClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于未完成轨道的 CSS 类名。"
    },
    {
      "name": "indicatorClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于移动进度指示器的 CSS 类名。"
    }
  ],
  "usage": "在嵌套滚动区域中同时传入 `container` 和 `target`。`offset` 使用 Motion 的滚动偏移语法；例如 `[\"start start\", \"end end\"]`\n表示目标顶部到达容器顶部时从 0 开始，目标底部到达容器底部时到 1。进度属于辅助导航，应同时提供章节标题和明确的页面结构。",
  "examples": [
    {
      "name": "scroll-progress-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/scroll-progress.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/scroll-progress",
  "sourceUrl": "https://ui.wzx.wang/r/scroll-progress.json"
}
