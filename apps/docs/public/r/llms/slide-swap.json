{
  "name": "slide-swap",
  "type": "registry:ui",
  "title": "内容滑动交换 Slide Swap",
  "description": "整块内容从上方移出，同时由下方滑入相同内容。",
  "categories": [
    "motion"
  ],
  "import": "import { SlideSwap } from \"@/components/ui/slide-swap\"",
  "exports": [
    "SlideSwap"
  ],
  "typeExports": [
    "SlideSwapProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/slide-swap",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/slide-swap.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "同时用于离场和入场图层的内容。"
    },
    {
      "name": "direction",
      "type": "\"up\" | \"down\"",
      "required": false,
      "control": "select",
      "options": [
        "up",
        "down"
      ],
      "defaultValue": "up",
      "description": "当前可见图层离场的方向。"
    },
    {
      "name": "active",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否从组件外部强制切换到交换状态。"
    },
    {
      "name": "transition",
      "type": "Transition",
      "required": false,
      "control": "text",
      "defaultValue": "{ duration: 0.42, ease: [0.22, 1, 0.36, 1] }",
      "description": "两个内容图层共用的过渡动画。"
    }
  ],
  "usage": "组件只负责视觉内容，实际链接或按钮语义应放在外层。通过 `direction=\"down\"` 可以反转方向，也可以传入 `active` 由外部状态控制交换。\n如果内容变化会影响操作含义，应同时更新外层元素的可访问名称，不能只改变视觉文字。",
  "examples": [
    {
      "name": "slide-swap-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/slide-swap.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/slide-swap",
  "sourceUrl": "https://ui.wzx.wang/r/slide-swap.json"
}
