{
  "name": "@wui/mcp",
  "version": "0.0.0",
  "description": "MCP server that exposes the wui component library (props, usage rules, examples) to LLM agents.",
  "type": "module",
  "bin": {
    "wui-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": "./src/core/index.ts"
  },
  "files": [
    "dist",
    "src/core"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
