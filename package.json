{
  "name": "wui-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "tokens:audit": "turbo run tokens:audit",
    "registry:build": "turbo run registry:build",
    "format": "prettier --write \"**/*.{ts,tsx,md,mjs,json}\" --ignore-path .gitignore"
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "turbo": "^2.5.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  }
}
