{
  "name": "breadcrumb",
  "type": "registry:ui",
  "title": "面包屑 Breadcrumb",
  "description": "显示当前页面在应用信息架构中的层级路径，帮助用户快速感知位置并返回上层页面。",
  "categories": [
    "navigation"
  ],
  "import": "import { Breadcrumb, BreadcrumbEllipsis, BreadcrumbItem, BreadcrumbLink, BreadcrumbList, BreadcrumbPage, BreadcrumbSeparator } from \"@/components/ui/breadcrumb\"",
  "exports": [
    "Breadcrumb",
    "BreadcrumbEllipsis",
    "BreadcrumbItem",
    "BreadcrumbLink",
    "BreadcrumbList",
    "BreadcrumbPage",
    "BreadcrumbSeparator"
  ],
  "typeExports": [
    "BreadcrumbLinkProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/breadcrumb",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/breadcrumb.json",
    "npmDependencies": [
      "lucide-react",
      "radix-ui"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [],
  "examples": [
    {
      "name": "breadcrumb-demo",
      "title": "基础用法"
    },
    {
      "name": "breadcrumb-with-icons",
      "title": "搭配图标指示"
    },
    {
      "name": "breadcrumb-custom-separator",
      "title": "自定义分隔符"
    },
    {
      "name": "breadcrumb-dropdown",
      "title": "折叠长路径与下拉菜单"
    },
    {
      "name": "breadcrumb-collapsed",
      "title": "简单折叠占位"
    }
  ],
  "files": [
    "registry/ui/breadcrumb.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/breadcrumb",
  "sourceUrl": "https://ui.wzx.wang/r/breadcrumb.json"
}
