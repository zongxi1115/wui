{
  "name": "scroll-snap",
  "type": "registry:ui",
  "title": "滚动吸附 Scroll Snap",
  "description": "基于原生 CSS Scroll Snap 规范构建的高性能全屏或横向分段吸附容器组件。",
  "categories": [
    "scroll"
  ],
  "import": "import { ScrollSnap, ScrollSnapItem } from \"@/components/ui/scroll-snap\"",
  "exports": [
    "ScrollSnap",
    "ScrollSnapItem"
  ],
  "typeExports": [
    "ScrollSnapItemProps",
    "ScrollSnapProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/scroll-snap",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/scroll-snap.json",
    "npmDependencies": [],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "axis",
      "type": "\"x\" | \"y\"",
      "required": false,
      "control": "select",
      "options": [
        "x",
        "y"
      ],
      "defaultValue": "y",
      "description": "滚动吸附的方向。"
    },
    {
      "name": "strictness",
      "type": "\"mandatory\" | \"proximity\"",
      "required": false,
      "control": "select",
      "options": [
        "mandatory",
        "proximity"
      ],
      "defaultValue": "mandatory",
      "description": "浏览器是否必须最终停在某个吸附点上。"
    },
    {
      "name": "hideScrollbar",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否隐藏原生滚动条，同时保留滚动能力。"
    }
  ],
  "examples": [
    {
      "name": "scroll-snap-demo",
      "title": "基础用法"
    },
    {
      "name": "scroll-snap-horizontal",
      "title": "横向财务指标卡吸附"
    }
  ],
  "files": [
    "registry/ui/scroll-snap.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/scroll-snap",
  "sourceUrl": "https://ui.wzx.wang/r/scroll-snap.json"
}
