{
  "name": "smooth-scroll",
  "type": "registry:ui",
  "title": "平滑滚动 Smooth Scroll",
  "description": "用 Lenis 为页面或自定义容器提供惯性平滑滚动基座。",
  "categories": [
    "scroll",
    "motion"
  ],
  "import": "import { SmoothScroll } from \"@/components/ui/smooth-scroll\"",
  "exports": [
    "SmoothScroll"
  ],
  "typeExports": [
    "SmoothScrollProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/smooth-scroll",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/smooth-scroll.json",
    "npmDependencies": [
      "lenis"
    ],
    "registryDependencies": []
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": false,
      "control": "text",
      "description": "要放入 Lenis 上下文或自定义滚动容器中的内容。"
    },
    {
      "name": "options",
      "type": "LenisOptions",
      "required": false,
      "control": "text",
      "description": "Lenis 实例的配置。"
    },
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否停用插值滚动，但保留内容包装结构。"
    },
    {
      "name": "respectReducedMotion",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否遵循操作系统的减少动态效果偏好。"
    },
    {
      "name": "root",
      "type": "boolean | \"asChild\"",
      "required": false,
      "control": "text",
      "defaultValue": "true",
      "description": "是否在页面上初始化全局 Lenis 实例。"
    },
    {
      "name": "autoRaf",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "true",
      "description": "是否自动使用 requestAnimationFrame 驱动 Lenis。"
    }
  ],
  "usage": "平滑滚动应作为页面级能力只挂载一次，不要在普通卡片中层层嵌套。模态框、代码编辑器和需要原生滚动的区域可使用 Lenis 的\n`data-lenis-prevent` 属性。组件会尊重用户的“减少动态效果”偏好，此时保留内容并停止滚动插值，恢复为普通滚动行为。\n\nLenis 的完整选项、推荐 CSS 和集成方式请参考[官方 React 文档](https://github.com/darkroomengineering/lenis/tree/main/packages/react)。",
  "examples": [
    {
      "name": "smooth-scroll-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/smooth-scroll.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/smooth-scroll",
  "sourceUrl": "https://ui.wzx.wang/r/smooth-scroll.json"
}
