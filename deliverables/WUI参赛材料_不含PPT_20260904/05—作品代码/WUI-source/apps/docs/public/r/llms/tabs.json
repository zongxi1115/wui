{
  "name": "tabs",
  "type": "registry:ui",
  "title": "标签栏 Tabs",
  "description": "用于在同一界面区域切换展示同层级内容分区的导航组件，内置共享布局弹性滑块动效与完整的键盘无障碍能力。",
  "import": "import { Tabs, TabsContent, TabsList, TabsTrigger, tabsListVariants } from \"@/components/ui/tabs\"",
  "exports": [
    "Tabs",
    "TabsContent",
    "TabsList",
    "TabsTrigger",
    "tabsListVariants"
  ],
  "typeExports": [
    "TabsListProps",
    "TabsProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/tabs",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/tabs.json",
    "npmDependencies": [
      "radix-ui",
      "class-variance-authority",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "examples": [
    {
      "name": "tabs-demo",
      "title": "胶囊式标签与微动效"
    },
    {
      "name": "tabs-underline",
      "title": "下划线样式与设置页"
    },
    {
      "name": "tabs-controlled",
      "title": "受控模式与动态徽标"
    },
    {
      "name": "tabs-card",
      "title": "综合业务表单选项卡"
    }
  ],
  "files": [
    "registry/ui/tabs.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/tabs",
  "sourceUrl": "https://ui.wzx.wang/r/tabs.json"
}
