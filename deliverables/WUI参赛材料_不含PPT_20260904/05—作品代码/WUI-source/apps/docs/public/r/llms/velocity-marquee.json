{
  "name": "velocity-marquee",
  "type": "registry:ui",
  "title": "滚动速度跑马灯 Velocity Marquee",
  "description": "跑马灯根据滚动速度加速，并随滚动方向反转。",
  "categories": [
    "scroll",
    "motion"
  ],
  "import": "import { VelocityMarquee } from \"@/components/ui/velocity-marquee\"",
  "exports": [
    "VelocityMarquee"
  ],
  "typeExports": [
    "VelocityMarqueeProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/velocity-marquee",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/velocity-marquee.json",
    "npmDependencies": [
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "required": true,
      "control": "text",
      "description": "在无缝轨道中重复显示的内容。"
    },
    {
      "name": "baseSpeed",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "36",
      "description": "静止滚动时轨道的速度，单位为每秒像素数。"
    },
    {
      "name": "sensitivity",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "0.08",
      "description": "滚动速度每增加一个单位时，轨道额外增加的速度。"
    },
    {
      "name": "maxBoost",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "180",
      "description": "由滚动速度带来的最大加速值，单位为每秒像素数。"
    },
    {
      "name": "gap",
      "type": "number",
      "required": false,
      "control": "number",
      "defaultValue": "32",
      "description": "重复内容组之间的间距。"
    },
    {
      "name": "reverse",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "defaultValue": "false",
      "description": "是否反转基础滚动方向和跟随滚动的方向。"
    },
    {
      "name": "container",
      "type": "RefObject<HTMLElement | null>",
      "required": false,
      "control": "text",
      "description": "要监听的滚动容器；未设置时监听页面。"
    },
    {
      "name": "groupClassName",
      "type": "string",
      "required": false,
      "control": "text",
      "description": "应用于每个重复内容组的 CSS 类名。"
    }
  ],
  "usage": "`sensitivity` 决定滚动反馈强度，`maxBoost` 防止触控板快速滑动造成不可读的速度。斜置效果应在组件外通过小角度 `rotate` 完成。\n组件离开视口或用户开启“减少动态效果”时会停止动画；后者回退为可横向滚动内容。",
  "examples": [
    {
      "name": "velocity-marquee-demo",
      "title": "基础用法"
    }
  ],
  "files": [
    "registry/ui/velocity-marquee.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/velocity-marquee",
  "sourceUrl": "https://ui.wzx.wang/r/velocity-marquee.json"
}
