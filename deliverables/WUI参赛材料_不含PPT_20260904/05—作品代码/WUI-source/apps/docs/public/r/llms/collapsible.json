{
  "name": "collapsible",
  "type": "registry:ui",
  "title": "折叠面板 Collapsible",
  "description": "按需展开与收起补充内容的渐进式披露组件，内置平滑高度补间动效与完整的键盘无障碍控制。",
  "categories": [
    "layout"
  ],
  "import": "import { Collapsible, CollapsibleContent, CollapsibleTrigger } from \"@/components/ui/collapsible\"",
  "exports": [
    "Collapsible",
    "CollapsibleContent",
    "CollapsibleTrigger"
  ],
  "typeExports": [
    "CollapsibleProps",
    "CollapsibleTriggerProps"
  ],
  "install": {
    "wui": "pnpm dlx @wui-design/cli@latest add @wui/collapsible",
    "shadcn": "pnpm dlx shadcn@latest add https://ui.wzx.wang/r/collapsible.json",
    "npmDependencies": [
      "radix-ui",
      "lucide-react",
      "motion"
    ],
    "registryDependencies": [
      "utils"
    ]
  },
  "props": [
    {
      "name": "disabled",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否禁用组件。"
    },
    {
      "name": "asChild",
      "type": "boolean",
      "required": false,
      "control": "boolean",
      "description": "是否将组件渲染为唯一的子元素，并将组件的属性和事件传递给该子元素。"
    }
  ],
  "examples": [
    {
      "name": "collapsible-demo",
      "title": "基础用法"
    },
    {
      "name": "collapsible-controlled",
      "title": "受控状态模式"
    },
    {
      "name": "collapsible-nested",
      "title": "代码变更折叠列表（Git Diff）"
    },
    {
      "name": "collapsible-card",
      "title": "表单卡片中的高级配置区块"
    }
  ],
  "files": [
    "registry/ui/collapsible.tsx"
  ],
  "docsUrl": "https://ui.wzx.wang/docs/components/collapsible",
  "sourceUrl": "https://ui.wzx.wang/r/collapsible.json"
}
